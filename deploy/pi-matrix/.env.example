# Copie ce fichier en `.env` et remplis-le. NE COMMITE PAS ton `.env`.

# Nom du homeserver = le sous-domaine qui pointe vers le Pi (A/AAAA record).
# Il devient la partie après ':' dans les IDs (@reco-bot:matrix.unebonnere.co).
# PERMANENT : ne le change plus après le premier démarrage.
MATRIX_DOMAIN=matrix.unebonnere.co

# Jeton d'inscription (protège la registration le temps de créer les comptes).
# Mets une longue chaîne aléatoire, ex. `openssl rand -hex 24`.
MATRIX_REGISTRATION_TOKEN=change-moi-chaine-aleatoire

# Compte du bot qui postera les notifs (créé par register-bot.sh).
BOT_USER=reco-bot
BOT_PASS=change-moi-mot-de-passe-bot

# Ton propre identifiant Matrix (celui que tu crées dans Element), pour que le
# bot t'invite dans le salon de notifs. Format @toi:MATRIX_DOMAIN.
MY_USER_ID=@etienne:matrix.unebonnere.co
