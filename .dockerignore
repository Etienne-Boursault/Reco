# Build artefacts re-générables
node_modules
dist
.astro

# Git/CI
.git
.github
.gitignore

# Venvs
.venv
tools/.venv

# Secrets — NE JAMAIS embarquer dans l'image
.env
.env.*
!.env.example
tools/.env

# SQLite caches (volumineux + machine-locale)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Sorties du pipeline — TOUT le répertoire, pas seulement quelques
# sous-dossiers. Les exclusions étaient nommées une par une, si bien que ce qui
# n'était pas listé partait dans l'image : `tools/output/audio` y pesait à lui
# seul 8,4 Go. Or `docker-compose` monte `./tools/output` en volume dans les
# deux services qui s'en servent, et le `mkdir -p` du Dockerfile recrée
# l'arborescence vide : rien de tout cela n'a à voyager dans l'image.
tools/output
tools/dispatch

# Python
__pycache__
*.pyc
.pytest_cache
.coverage
.coverage.*
htmlcov

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Mémoires/artefacts ruflo/claude-flow — pas d'intérêt en runtime conteneur
.claude
.claude-flow
.swarm
agentdb.rvf
agentdb.rvf.lock
ruvector.db
.mcp.json

# Tests inutiles dans image runtime (image dev — on les garde via volume si besoin)
htmlcov
*.log

# Docs longues (gardées en repo, pas dans image)
docs
