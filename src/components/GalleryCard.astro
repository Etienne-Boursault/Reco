---
/**
 * GalleryCard.astro — carte minimaliste pour les galeries (films, livres,
 * musique, séries, invités). Volontairement plus simple que `RecoCard` :
 *  - pas de bouton dropdown de liens marchands
 *  - pas de citation
 *  - juste type + titre + créateur·rice + compteur "N mentions"
 *
 * A11y :
 *  - `<article>` sémantique
 *  - `<h3>` (la page parent posera h1 + h2)
 *  - emoji décoratif via `aria-hidden` + libellé textuel en label
 */
import { TYPE_LABELS } from '../utils/recoTypes';
import { iconeDuType } from '../utils/iconesTypes';
import { t } from '../i18n';
import CreatorFlag from './CreatorFlag.astro';

export interface Props {
  /** id de l'item (utilisé pour l'ancre, pas pour le routing). */
  id: string;
  title: string;
  types: readonly string[];
  creator?: string | null;
  mentionCount: number;
  /**
   * X2 — Si fourni, la carte devient un `<a>` cliquable vers cette URL
   * (typiquement `/<source>/oeuvre/<itemId>`). Sinon, rend un `<article>`
   * non-cliquable (compat ascendante).
   */
  href?: string | null;
  /**
   * Types de la galerie qui affiche la carte. Une œuvre à plusieurs types y
   * prend celui de la galerie : Kaamelott, série ET film, apparaissait dans
   * « Tous les films » sous le badge « SÉRIE » (audit d'interface du
   * 2026-10-07, item #19). Absent : règle par défaut, inchangée.
   */
  galleryTypes?: readonly string[];
}

// NB : pas de prop `year`. L'année de création d'une œuvre ne dit rien à qui
// parcourt un catalogue — même arbitrage que sur `RecoCard.astro`, où elle a
// été retirée. Elle restait ici, et produisait en prime une aberration : sans
// créateur, elle s'affichait à sa place, dans un `<p class="gcard-creator">`.
// Le champ reste disponible sur la page œuvre, où il a du sens.
const { id, title, types, creator, mentionCount, href, galleryTypes } = Astro.props;

// Type primaire : le premier qui DIT quelque chose.
//
// « autre » est le type de repli, et il ne devrait jamais l'emporter sur un
// type precis. Il le faisait pourtant : la page /series affichait le badge
// « AUTRE » sur « Bref », « Succession », « Iris »… — toutes des series
// portant `types: ['autre', 'serie']`. Signale a la relecture du 2026-08-19.
//
// L'ordre alphabetique n'y etait pas pour rien : la fusion des doublons du
// 2026-08-18 reunit les types avec `sorted(set(...))`, ce qui pousse « autre »
// en tete. Les donnees ont ete nettoyees par `nettoyer_type_autre.py`, mais
// la carte ne doit pas dependre de leur ordre : rien n'empeche un nouvel
// import de le remettre.
//
// On ne REORDONNE pas les types precis entre eux — `['film', 'serie']` reste
// un film. Seul « autre » est deprioritise.
//
// Dans une galerie typée, le type de la galerie passe d'abord, s'il est l'un
// de ceux de l'œuvre : la carte ne contredit pas la page qui la porte.
const typeDeLaGalerie = galleryTypes?.length
  ? types.find((t) => galleryTypes.includes(t))
  : undefined;
const primary = typeDeLaGalerie ?? types.find((t) => t !== 'autre') ?? types[0] ?? 'autre';
const typeLabel = TYPE_LABELS[primary] ?? 'Autre';
const mentionLabel = mentionCount > 1 ? 'mentions' : 'mention';

// Cliquable ou non, le corps de la carte est le MÊME. On choisit donc la
// balise racine dynamiquement plutôt que de dupliquer le gabarit : deux
// copies à maintenir en parallèle finissent toujours par diverger.
const Root = href ? 'a' : 'article';
// PAS d'`aria-label` sur le lien. Il en portait un — « <titre> — Voir la page
// complète de l'œuvre » — qui REMPLAÇAIT le contenu de la carte au lieu de le
// compléter : le type, le créateur et le nombre de mentions disparaissaient
// pour les lecteurs d'écran, et une commande vocale prononçant le texte visible
// ne trouvait plus le lien (WCAG 2.5.3 « Label in Name » ; Lighthouse en
// comptait 203 sur une seule galerie, audit du 2026-08-16).
// Le nom accessible est donc calculé depuis le CONTENU, auquel on ajoute
// l'intention de l'action dans un `.visually-hidden` — visible des seuls
// lecteurs d'écran, et inclus dans le nom puisqu'il fait partie du contenu.
const rootAttrs = href ? { class: 'gcard gcard--link', href } : { class: 'gcard' };
---

<Root {...rootAttrs} data-item-id={id} data-types={types.join(',')}>
  {/* Icône au trait dans la couleur d'accent, comme l'onglet « Par type »
     (audit d'interface du 2026-10-07, second passage) : l'emoji donnait aux
     galeries un autre visage que l'onglet qui y mène. */}
  <div class="gcard-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconeDuType(primary)} /></svg></div>
  <div class="gcard-body">
    {/* `aria-label` sur un `<p>` est SANS EFFET : ARIA ne l'autorise que sur
       les éléments porteurs d'un rôle. Le préfixe passe donc par du texte
       réellement présent, réservé aux lecteurs d'écran. */}
    <p class="gcard-type"><span class="visually-hidden">Type : </span>{typeLabel}</p>
    <h3 class="gcard-title">{title}</h3>
    {creator && (
      <p class="gcard-creator">
        {creator}
        <CreatorFlag name={creator} interactive={false} />
      </p>
    )}
    <p class="gcard-count">
      <span class="gcard-count-n">{mentionCount}</span>
      <span class="gcard-count-l">{mentionLabel}</span>
    </p>
  </div>
  {href && <span class="visually-hidden">— {t('work.openA11y')}</span>}
</Root>

<style>
  .gcard {
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 8%, transparent);
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  /* Survol réservé aux vrais pointeurs, appui immédiat pour tous — cf. la
     convention en tête de `global.css` (audit d'interface du 2026-10-07). */
  @media (hover: hover) and (pointer: fine) {
    .gcard:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
  }
  /* X2 — variante cliquable : on retire la décoration de lien et on hérite
     la couleur du texte. Le focus-ring global s'applique via :focus-visible
     (cf. global.css `:where(...):focus-visible`). */
  a.gcard--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    a.gcard--link:hover .gcard-title {
      color: var(--accent);
    }
  }
  /* Seule la variante LIEN réagit à l'appui : une carte inerte qui
     s'enfonce promettrait une action qui n'existe pas. */
  a.gcard--link:active {
    transform: scale(0.98);
    border-color: var(--accent);
    transition-duration: 0.08s;
  }
  .gcard-icon {
    display: flex;
    color: var(--accent);
    flex-shrink: 0;
  }
  .gcard-body {
    flex: 1;
    min-width: 0;
    /* Le compteur de mentions se cale en bas de la carte : sur une grille
       aux hauteurs egalisees, il s'alignait sinon juste sous le titre, a
       des hauteurs differentes d'une carte a l'autre. */
    display: flex;
    flex-direction: column;
  }
  .gcard-count {
    margin-top: auto;
  }
  .gcard-type {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.2rem;
    font-weight: 600;
  }
  /* Le titre d'une œuvre s'écrit ici comme sur sa carte de reco et dans la
     palette de recherche : Bebas Neue en capitales, la police des titres du
     site (h3 global). Il était composé en Inter gras, si bien que la même
     œuvre changeait de visage d'une page à l'autre (audit d'interface du
     2026-10-07). Corps plus petit que sur `RecoCard` : la galerie aligne
     cinq cartes de front, la carte de reco quatre. */
  .gcard-title {
    font-size: 1.35rem;
    /* Interligne ET rembourrage haut : le titre coupe ce qui dépasse
       (`overflow: hidden`, plus bas), et l'accent d'une capitale — le É
       d'« Amélie » — monte au-dessus de la ligne. À l'interligne serré des
       autres titres Bebas (0,98), il était rogné : « AMELIE POULAIN ». */
    line-height: 1.1;
    padding-top: 0.12em;
    margin: 0 0 0.3rem;
    /* Évite que des titres très longs cassent la grid */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gcard-creator {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 0.4rem;
  }
  .gcard-count {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .gcard-count-n {
    color: var(--accent);
    font-weight: 700;
  }

  /* Téléphone : une LIGNE par œuvre. Les cartes hautes, une par rangée,
     faisaient de « Tous les films » une page de 30 631 px (audit d'interface
     du 2026-10-07, second passage). Icône, titre et créateur à gauche, le
     nombre de mentions en grand chiffre jaune à droite — la forme de l'onglet
     « Par type ». Le type, redondant dans une galerie typée, n'est plus
     affiché mais reste lu par les lecteurs d'écran. */
  @media (max-width: 560px) {
    .gcard {
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
    }
    .gcard-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'titre n'
        'createur n';
      column-gap: 0.75rem;
      align-items: center;
    }
    .gcard-type {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .gcard-title {
      grid-area: titre;
      margin: 0;
      font-size: 1.3rem;
      -webkit-line-clamp: 2;
    }
    .gcard-creator {
      grid-area: createur;
      margin: 0;
      font-size: 0.8rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .gcard-count {
      grid-area: n;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .gcard-count-n {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 1.9rem;
      line-height: 0.9;
    }
  }
</style>
