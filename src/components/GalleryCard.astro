---
/**
 * GalleryCard.astro — carte minimaliste pour les galeries (films, livres,
 * musique, séries, invités). Volontairement plus simple que `RecoCard` :
 *  - pas de bouton dropdown de liens marchands
 *  - pas de citation
 *  - juste type + titre + créateur·rice + compteur "N mentions"
 *
 * A11y :
 *  - `<article>` sémantique
 *  - `<h3>` (la page parent posera h1 + h2)
 *  - emoji décoratif via `aria-hidden` + libellé textuel en label
 */
import { TYPE_EMOJIS, TYPE_LABELS } from '../utils/recoTypes';
import { t } from '../i18n';
import CreatorFlag from './CreatorFlag.astro';

export interface Props {
  /** id de l'item (utilisé pour l'ancre, pas pour le routing). */
  id: string;
  title: string;
  types: readonly string[];
  creator?: string | null;
  mentionCount: number;
  /**
   * X2 — Si fourni, la carte devient un `<a>` cliquable vers cette URL
   * (typiquement `/<source>/oeuvre/<itemId>`). Sinon, rend un `<article>`
   * non-cliquable (compat ascendante).
   */
  href?: string | null;
}

// NB : pas de prop `year`. L'année de création d'une œuvre ne dit rien à qui
// parcourt un catalogue — même arbitrage que sur `RecoCard.astro`, où elle a
// été retirée. Elle restait ici, et produisait en prime une aberration : sans
// créateur, elle s'affichait à sa place, dans un `<p class="gcard-creator">`.
// Le champ reste disponible sur la page œuvre, où il a du sens.
const { id, title, types, creator, mentionCount, href } = Astro.props;

// Type primaire : le premier qui DIT quelque chose.
//
// « autre » est le type de repli, et il ne devrait jamais l'emporter sur un
// type precis. Il le faisait pourtant : la page /series affichait le badge
// « AUTRE » sur « Bref », « Succession », « Iris »… — toutes des series
// portant `types: ['autre', 'serie']`. Signale a la relecture du 2026-08-19.
//
// L'ordre alphabetique n'y etait pas pour rien : la fusion des doublons du
// 2026-08-18 reunit les types avec `sorted(set(...))`, ce qui pousse « autre »
// en tete. Les donnees ont ete nettoyees par `nettoyer_type_autre.py`, mais
// la carte ne doit pas dependre de leur ordre : rien n'empeche un nouvel
// import de le remettre.
//
// On ne REORDONNE pas les types precis entre eux — `['film', 'serie']` reste
// un film. Seul « autre » est deprioritise.
const primary = types.find((t) => t !== 'autre') ?? types[0] ?? 'autre';
const emoji = TYPE_EMOJIS[primary] ?? TYPE_EMOJIS.autre;
const typeLabel = TYPE_LABELS[primary] ?? 'Autre';
const mentionLabel = mentionCount > 1 ? 'mentions' : 'mention';

// Cliquable ou non, le corps de la carte est le MÊME. On choisit donc la
// balise racine dynamiquement plutôt que de dupliquer le gabarit : deux
// copies à maintenir en parallèle finissent toujours par diverger.
const Root = href ? 'a' : 'article';
// PAS d'`aria-label` sur le lien. Il en portait un — « <titre> — Voir la page
// complète de l'œuvre » — qui REMPLAÇAIT le contenu de la carte au lieu de le
// compléter : le type, le créateur et le nombre de mentions disparaissaient
// pour les lecteurs d'écran, et une commande vocale prononçant le texte visible
// ne trouvait plus le lien (WCAG 2.5.3 « Label in Name » ; Lighthouse en
// comptait 203 sur une seule galerie, audit du 2026-08-16).
// Le nom accessible est donc calculé depuis le CONTENU, auquel on ajoute
// l'intention de l'action dans un `.visually-hidden` — visible des seuls
// lecteurs d'écran, et inclus dans le nom puisqu'il fait partie du contenu.
const rootAttrs = href ? { class: 'gcard gcard--link', href } : { class: 'gcard' };
---

<Root {...rootAttrs} data-item-id={id} data-types={types.join(',')}>
  <div class="gcard-icon" aria-hidden="true">{emoji}</div>
  <div class="gcard-body">
    {/* `aria-label` sur un `<p>` est SANS EFFET : ARIA ne l'autorise que sur
       les éléments porteurs d'un rôle. Le préfixe passe donc par du texte
       réellement présent, réservé aux lecteurs d'écran. */}
    <p class="gcard-type"><span class="visually-hidden">Type : </span>{typeLabel}</p>
    <h3 class="gcard-title">{title}</h3>
    {creator && (
      <p class="gcard-creator">
        {creator}
        <CreatorFlag name={creator} interactive={false} />
      </p>
    )}
    <p class="gcard-count">
      <span class="gcard-count-n">{mentionCount}</span>
      <span class="gcard-count-l">{mentionLabel}</span>
    </p>
  </div>
  {href && <span class="visually-hidden">— {t('work.openA11y')}</span>}
</Root>

<style>
  .gcard {
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 8%, transparent);
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .gcard:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  /* X2 — variante cliquable : on retire la décoration de lien et on hérite
     la couleur du texte. Le focus-ring global s'applique via :focus-visible
     (cf. global.css `:where(...):focus-visible`). */
  a.gcard--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  a.gcard--link:hover .gcard-title {
    color: var(--accent);
  }
  .gcard-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .gcard-body {
    flex: 1;
    min-width: 0;
  }
  .gcard-type {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.2rem;
    font-weight: 600;
  }
  .gcard-title {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.25;
    margin: 0 0 0.25rem;
    /* Évite que des titres très longs cassent la grid */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gcard-creator {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 0.4rem;
  }
  .gcard-count {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .gcard-count-n {
    color: var(--accent);
    font-weight: 700;
  }
</style>
