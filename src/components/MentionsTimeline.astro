---
/**
 * MentionsTimeline — liste chronologique des épisodes où une œuvre est
 * citée. Chaque entrée : titre épisode (lien), date, recommandedBy, quote
 * et timestamp YouTube cliquable si applicable.
 *
 * A11y :
 *  - `<ol>` ordonné (sémantique de séquence temporelle).
 *  - `<time datetime>` sur les dates.
 *  - Liens externes marqués via le pattern global `a11y.externalLinkSuffix`.
 */
import type { JoinedMention } from '../lib/work/aggregator';
import { youtubeDeepLink } from '../lib/work/aggregator';
import { episodeLabel } from '../utils/recoTypes';
import { titreEpisodeAffiche } from '../utils/titreEpisode';
import { verbeMention } from '../utils/verbeMention';
import { t } from '../i18n';
import {
  extractYoutubeId,
  parseTimecode,
} from '../lib/audio/timecode';
import AudioExcerpt from './AudioExcerpt.astro';
import OutboundLink from './OutboundLink.astro';

interface Props {
  sourceId: string;
  mentions: JoinedMention[];
  /** Nom du podcast, pour retirer des titres le suffixe « (Un Bon Moment,
   *  S6-E03) » qui répète le numéro affiché juste devant. */
  podcastTitle?: string;
  /** Créateur de l'œuvre : « Présentée par » n'est juste que pour lui
   *  (cf. `utils/verbeMention.ts`). */
  creator?: string | null;
}
const { sourceId, mentions, podcastTitle, creator } = Astro.props;

/** Le verbe de la ligne, dans le libellé propre à la chronologie. */
const CLE_DU_VERBE = {
  'Évoquée par': 'work.mentions.byCitation',
  'Présentée par': 'work.mentions.byGuestWork',
  'Reco de': 'work.mentions.byReco',
} as const;

function fmtDate(d?: Date): string {
  if (!d || !(d instanceof Date) || Number.isNaN(d.getTime())) return '';
  // `timeZone: 'UTC'` explicite, comme `src/lib/stats/page.ts:234`. Sans lui,
  // la date affichée dépend du fuseau de la MACHINE DE BUILD : une date
  // stockée `2026-03-04T00:00:00Z` sort « 3 mars » depuis un fuseau négatif et
  // « 4 mars » depuis l'Europe. Le site serait donc daté différemment selon
  // l'endroit d'où on le construit.
  return d.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<ol class="timeline">
  {mentions.map((jm) => {
    const ep = jm.episode;
    const m = jm.mention;
    const ytLink = youtubeDeepLink(jm);
    const isCitation = m.kind === 'citation';
    const isGuestWork = m.guestWork === true;
    // Item #12 : extrait audio inline.
    // L'offset n'est légitime que si le timestamp vient de YouTube (cf.
    // politique transcripts : pas d'offset entre YT et Acast).
    const ytId = extractYoutubeId(ep?.youtubeUrl ?? null);
    const startSeconds =
      m.sourceRef.transcriptSource === 'youtube'
        ? parseTimecode(m.sourceRef.timestamp ?? null) ?? 0
        : 0;
    // UNE seule commande pour un instant donné (audit d'interface du
    // 2026-10-07, item #18). La fiche en offrait deux, l'une sous l'autre et
    // dans deux formats : « ▶ 00:42:20 », lien vers YouTube, et « Écouter à
    // 42m20s », l'extrait joué sur place. Quand l'extrait existe, il est seul.
    const extraitDisponible = Boolean(ytId) && startSeconds > 0;
    // Sinon, le lien vers l'épisode reste — mais SANS minutage. Il n'en porte
    // un vrai que dans le cas où l'extrait existe déjà ; ailleurs, il affichait
    // l'horodatage d'une transcription Acast à côté d'un lien YouTube qui ne
    // s'y cale pas, ce que la politique des transcripts interdit (jamais
    // d'offset entre les deux).
    const lienSeul = ytLink && !extraitDisponible;
    return (
      <li class:list={['tl-item', { 'tl-citation': isCitation }]}>
        <div class="tl-head">
          {ep ? (
            <a class="tl-ep" href={`/${sourceId}/episode/${ep.guid}`}>
              {episodeLabel(ep) && <span class="tl-epnum">{episodeLabel(ep)}</span>}
              <span class="tl-eptitle">{titreEpisodeAffiche(ep.youtubeTitle ?? ep.title, podcastTitle)}</span>
            </a>
          ) : (
            <span class="tl-eptitle tl-eptitle-orphan">{t('work.mentions.unknownEpisode')}</span>
          )}
          {ep?.date && (
            <time class="tl-date" datetime={ep.date.toISOString()}>
              {fmtDate(ep.date)}
            </time>
          )}
        </div>

        <div class="tl-meta">
          {isGuestWork && (
            <span class="tl-guestwork" aria-label={t('reco.guestWork.badgeA11y')}>
              {/* M3 : ⭐ — cf. RecoCard, évite la collision avec l'emoji du
                 type « artiste » (🎤). */}
              <span aria-hidden="true">⭐</span> {t('reco.guestWork.badge')}
            </span>
          )}
          {m.recommendedBy && (
            <span class="tl-by">
              {t(CLE_DU_VERBE[verbeMention({ ...m, creator })])} {m.recommendedBy}
            </span>
          )}
          {lienSeul && (
            <OutboundLink
              class="tl-ts"
              href={ytLink}
              category="youtube"
              sourceId={sourceId}
              recoId={m.id}
              ariaLabel={`${t('work.mentions.youtubeA11y')} ${t('a11y.externalLinkSuffix')}`}
            >
              <span aria-hidden="true">▶</span>
              {t('work.mentions.youtubeFallback')}
            </OutboundLink>
          )}
        </div>

        {m.quote && <blockquote class="tl-quote">« {m.quote} »</blockquote>}

        {extraitDisponible && (
          <div class="tl-audio">
            <AudioExcerpt
              youtubeId={ytId}
              startSeconds={startSeconds}
              id={m.id}
              title={ep ? (ep.youtubeTitle ?? ep.title) : undefined}
            />
          </div>
        )}
      </li>
    );
  })}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tl-item {
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 8%, transparent);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--accent);
  }
  .tl-citation {
    border-left-style: dashed;
    opacity: 0.85;
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .tl-ep {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: baseline;
  }
  .tl-ep:hover {
    color: var(--accent);
  }
  .tl-epnum {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .tl-eptitle {
    font-size: 1.02rem;
  }
  .tl-eptitle-orphan {
    color: var(--muted);
    font-style: italic;
  }
  .tl-date {
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.45rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tl-by {
    font-weight: 500;
  }
  /* Badge « œuvre d'invité » — accent ambre, cohérent avec RecoCard.
     H1 : teinte dérivée via `--guestwork` (cf. global.css) pour le contraste. */
  .tl-guestwork {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-weight: 600;
    color: var(--guestwork);
    border: 1px solid color-mix(in oklab, var(--guestwork) 45%, transparent);
    background: color-mix(in oklab, var(--guestwork) 12%, transparent);
    border-radius: 999px;
    padding: 0.05em 0.5em;
    font-size: 0.78rem;
  }
  /* `:global` : ce lien est rendu par `OutboundLink`, et Astro limite les
     styles d'un composant aux éléments qu'il écrit lui-même. La règle
     `.tl-ts` ne l'atteignait pas : la hauteur de 44 px déclarée au premier
     audit n'avait jamais pris, le lien mesurait toujours 22 px (second audit
     d'interface du 2026-10-07). Ancrée sous `.timeline`, elle ne déborde pas
     du composant. */
  .timeline :global(.tl-ts) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    color: var(--accent);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) and (pointer: fine) {
    .timeline :global(.tl-ts:hover) {
      text-decoration: underline;
    }
  }
  .tl-audio {
    margin-top: 0.6rem;
  }
  .tl-quote {
    margin: 0.7rem 0 0;
    padding: 0.4rem 0 0.2rem 0.8rem;
    border-left: 2px solid color-mix(in oklab, var(--text) 18%, transparent);
    color: var(--text);
    font-style: italic;
    font-size: 0.92rem;
  }
</style>
