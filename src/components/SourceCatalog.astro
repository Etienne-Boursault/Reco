---
/**
 * SourceCatalog.astro — Catalogue complet d'une source (header + vues
 * « Par épisode » / « Toutes les recos » avec recherche et filtres).
 *
 * Extrait de `pages/[source]/index.astro` pour être réutilisable à la racine
 * en mode mono-source : quand le déploiement n'a qu'un seul podcast, la page
 * d'accueil `/` EST ce catalogue (cf. `pages/index.astro`).
 *
 * Prop `isHome` : masque le lien « retour accueil » (le catalogue est la
 * racine) et cale les URLs canoniques / JSON-LD sur `/` au lieu de
 * `/${source.id}`.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
// Styles des cartes, importés BIEN QUE cette page n'en rende aucune : elle en
// INJECTE au clic sur l'onglet « toutes les recos ». Astro ne bundle que les
// styles des composants réellement rendus, et un composant importé sans être
// rendu est élagué — c'est ce qui a livré un fragment sans le moindre style,
// cartes sans fond ni bordure (signalé le 2026-08-17). Un import CSS, lui, est
// un effet de bord que le bundler ne peut pas supprimer.
import '../styles/fragment-recos.css';
import EmptyState from './EmptyState.astro';
import { TYPE_LABELS_PLURAL, episodeLabel } from '../utils/recoTypes';
import { sortRecosByTimestamp } from '../utils/recoOrder';
import { plural } from '../utils/plural';
import { t } from '../i18n';
import { sourceToPodcastSchema } from '../lib/seo/jsonld';
import { siteConfig } from '../config/site';

interface Props {
  source: CollectionEntry<'sources'>;
  /** À `true`, ce catalogue est rendu à la racine `/` (site mono-source). */
  isHome?: boolean;
}

const { source, isHome = false } = Astro.props;
const data = source.data;

// Recos de cette source (les « discarded » sont masquées du public).
// Les citations (kind=citation) restent visibles dans le catalogue avec leur
// badge « Mentionné », mais ne comptent pas dans le compteur principal.
// DÉCISION PRODUIT (CR Story 4) : les œuvres d'invité·es (`guestWork`) restent
// kind=reco et sont donc INCLUSES ici dans `trueRecos` et tous les compteurs —
// seule la page épisode les présente dans une sous-section séparée.
// Tri CHRONOLOGIQUE explicite : sans lui, l'ordre affiché serait celui
// d'énumération du chargeur de fichiers d'Astro — un détail d'implémentation
// que la migration 5 → 7 a effectivement changé. Cf. `src/utils/recoOrder.ts`.
const recos = sortRecosByTimestamp(
  (await getCollection('recos'))
    .filter((r) => r.data.sourceId.id === source.id && r.data.status !== 'discarded')
    .map((r) => r.data),
);
const trueRecos = recos.filter((r) => r.kind !== 'citation');

// Épisodes indexés par guid pour afficher le numéro/titre sur les cartes.
const episodes = (await getCollection('episodes')).filter(
  (e) => e.data.sourceId.id === source.id,
);
const epByGuid = new Map(episodes.map((e) => [e.data.guid, e.data]));

// Types présents (pour les filtres), triés par fréquence.
const counts = new Map<string, number>();
// Une reco multi-types compte dans chaque type (le filtre est inclusif).
for (const r of recos) for (const t of r.types) counts.set(t, (counts.get(t) ?? 0) + 1);
const types = [...counts.entries()].sort((a, b) => b[1] - a[1]);

// Vue « par épisode » : épisodes ayant ≥1 reco, du plus récent au plus ancien.
// On compte seulement les vraies recos (pas les citations) pour rester cohérent
// avec le compteur global affiché plus haut.
const recoCountByEp = new Map<string, number>();
for (const r of trueRecos)
  recoCountByEp.set(r.episodeGuid, (recoCountByEp.get(r.episodeGuid) ?? 0) + 1);
// Tous les épisodes (même sans reco validée), du plus RÉCENT au plus ancien —
// comme la chaîne YouTube. Retour utilisateur 2026-07-21 : afficher aussi les
// épisodes sans reco (ex. #21 McFly & Carlito).
const episodesWithRecos = episodes
  .map((e) => e.data)
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));

const ytThumb = (url?: string) => {
  const id = url?.match(/[?&]v=([\w-]+)/)?.[1];
  return id ? `https://i.ytimg.com/vi/${id}/mqdefault.jpg` : null;
};
const epLabel = episodeLabel;

// JSON-LD : PodcastSeries + BreadcrumbList (Accueil → Source).
// Cf. ADR 0021 §7 et ADR 0027 (mapping schema.org).
// En mode mono-source (`isHome`), l'index de la source EST la racine `/` :
// l'URL canonique pointe donc sur `/` et le fil d'Ariane est superflu.
const homeUrl = new URL('/', Astro.site).toString();
const sourceUrl = isHome ? homeUrl : new URL(`/${source.id}`, Astro.site).toString();
const podcastSchema = sourceToPodcastSchema({
  id: source.id,
  title: data.title,
  description: data.description,
  url: sourceUrl,
  rssUrl: data.rssUrl,
});
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: data.title, item: sourceUrl },
  ],
};
const jsonLd = isHome ? [podcastSchema] : [podcastSchema, breadcrumb];
---

<Layout
  title={isHome ? siteConfig.baseline : `${data.title} — recommandations`}
  description={data.description ?? `${trueRecos.length} ${plural(trueRecos.length, 'recommandation')} ${plural(trueRecos.length, 'extraite')} de ${episodesWithRecos.length} ${plural(episodesWithRecos.length, 'épisode')} du podcast ${data.title}.`}
  theme={data.theme}
  ogSlug={source.id}
  jsonLd={jsonLd}
>
  <header class="head wrap" role="banner">
    {
      !isHome && (
        <a class="back" href="/">
          <span aria-hidden="true">←</span> <span>{t('nav.backHome')}</span>
        </a>
      )
    }
    {/* En mode mono-source, cette page EST la racine : elle porte le nom du
       SITE, pas celui du podcast, et la baseline précise de quel podcast il
       s'agit. Ailleurs (page source d'un déploiement multi-source, fiches
       épisodes, fil d'Ariane, JSON-LD, cartes OG), `data.title` reste le nom
       du podcast — le renommer là serait faux. */}
    <h1>{isHome ? siteConfig.siteName : data.title}</h1>
    {isHome
      ? <p class="tag">{siteConfig.baseline}</p>
      : data.tagline && <p class="tag">{data.tagline}</p>}
    <p class="stat">
      {trueRecos.length} {plural(trueRecos.length, 'recommandation')}
    </p>
  </header>

  {/* C1/C5 : <main id="main" tabindex="-1"> enveloppe les 2 tabpanels ET la toolbar.
     Le skip-link cible bien le vrai <main>. */}
  <main id="main" tabindex="-1">
    <nav class="tabs wrap" aria-label={t('nav.tabsLabel')}>
      <div
        role="tablist"
        aria-label={t('nav.tabsLabel')}
        aria-orientation="horizontal"
        class="tablist"
      >
        <button
          class="tab is-active"
          data-view="episodes"
          role="tab"
          id="tab-episodes"
          aria-selected="true"
          aria-controls="view-episodes"
          tabindex="0"
        >
          Par épisode
        </button>
        <button
          class="tab"
          data-view="all"
          role="tab"
          id="tab-all"
          aria-selected="false"
          aria-controls="view-all"
          tabindex="-1"
        >
          Toutes les recos
        </button>
      </div>
    </nav>

    {/* Vue 1 : toutes les recos — CHARGÉE À LA DEMANDE.
       Elle pesait 2681 Ko et 24 887 balises, soit 96 % du document, alors
       qu'elle est masquée au chargement : le navigateur analysait 2,7 Mo pour
       afficher les 79 Ko de la vue « par épisode » (audit du 2026-08-16).
       Le contenu arrive maintenant au premier clic sur l'onglet, depuis
       `/[source]/recos-fragment`.
       SANS JAVASCRIPT, rien de tout cela ne se produit — d'où le lien vers la
       page complète, qui est le contenu réel de la section tant qu'aucun
       script ne l'a remplacé. Ce n'est pas un message d'erreur : c'est un
       chemin qui marche. */}
    <section
      id="view-all"
      role="tabpanel"
      aria-labelledby="tab-all"
      data-fragment={`/${source.id}/recos-fragment`}
      aria-busy="false"
      hidden
    >
      {/* Zone d'annonce, DÉLIBÉRÉMENT hors du conteneur remplacé.
         Une région `aria-live` doit être présente dans le DOM AVANT que son
         contenu change : créée en même temps que son message, elle n'annonce
         rien. C'est la même contrainte que pour `#noresult`, et la raison pour
         laquelle le fragment est injecté dans un enfant plutôt que dans la
         section entière. */}
      <p id="recos-statut" class="visually-hidden" role="status"
         aria-live="polite" aria-atomic="true"></p>
      <div data-recos-cible>
        <p class="wrap repli-recos">
          <a href={`/${source.id}/recos`}>Voir les {recos.length} recommandations →</a>
        </p>
      </div>
    </section>

    {/* Vue 2 : par épisode (miniatures, plus récent d'abord) — vue par défaut */}
    <section id="view-episodes" role="tabpanel" aria-labelledby="tab-episodes">
      <div class="toolbar wrap">
        <input
          id="ep-search"
          class="search"
          type="search"
          placeholder="Rechercher un épisode ou un invité…"
          autocomplete="off"
          aria-label="Rechercher un épisode"
        />
        {/* Le libellé est DANS le compteur : le filtre client le réécrit avec
            le nombre, sinon un « épisodes » figé resterait au pluriel quand la
            recherche ramène le compte à 1. */}
        <span class="ep-count">
          <span id="ep-visible">{`${episodesWithRecos.length} ${plural(episodesWithRecos.length, 'épisode')}`}</span>
        </span>
      </div>

      <div class="wrap">
        {/* C6 : heading explicite pour respecter la hiérarchie h1→h2. */}
        <h2 class="visually-hidden">{t('heading.episodesWithRecos')}</h2>
        <ul class="ep-grid" id="ep-grid" aria-label="Épisodes du podcast">
          {
            episodesWithRecos.map((e, i) => {
              // Les PREMIÈRES vignettes sont au-dessus de la ligne de
              // flottaison : les charger en `lazy` était un contresens. Une
              // image lazy attend que le navigateur ait fini sa mise en page
              // pour décider qu'elle est visible — or c'est précisément
              // celle-ci qui détermine le LCP. Lighthouse la désignait comme
              // élément LCP à 3,1 s (audit du 2026-08-16).
              // 3 cartes : ce que couvre un écran mobile de 412 px de large.
              const auDessusDeLaLigne = i < 3;
              // Miniature : vignette YouTube si dispo, sinon artwork Acast
              // (imageUrl) — évite les cartes sans image (ex. Alice David #18).
              const thumb = ytThumb(e.youtubeUrl) ?? e.imageUrl ?? null;
              // Titre FRANÇAIS du flux (e.title) plutôt que le titre YouTube,
              // parfois en anglais (ex. « A Good Time with BROUTE »).
              const epTitle = e.title;
              const epLabelStr = epLabel(e);
              // Normalisation SSR (sans accents + lowercase) pour la recherche
              // tolérante côté client. On garde le titre YouTube dans la clé
              // pour rester trouvable par l'un ou l'autre libellé.
              const searchKey = `${e.title} ${e.youtubeTitle ?? ''} ${epLabelStr}`
                .normalize('NFD')
                .replace(/[̀-ͯ]/g, '')
                .toLowerCase();
              // PAS d'`aria-label` sur le lien. Il valait « S1·E12 — <titre> »
              // et REMPLAÇAIT le contenu : le nombre de recos, pourtant
              // visible, disparaissait pour les lecteurs d'écran, et une
              // commande vocale prononçant le texte affiché ne trouvait plus
              // la carte (WCAG 2.5.3 ; 110 occurrences sur l'accueil, audit du
              // 2026-08-16). Le numéro d'épisode reste annoncé : c'est le
              // BADGE qui le porte, désormais lisible plutôt qu'`aria-hidden`.
              return (
                <li class="ep-card" data-search={searchKey}>
                  <a href={`/${source.id}/episode/${e.guid}`}>
                    <div class="ep-thumb">
                      {thumb && (
                        <img
                          src={thumb}
                          alt=""
                          loading={auDessusDeLaLigne ? 'eager' : 'lazy'}
                          fetchpriority={auDessusDeLaLigne ? 'high' : undefined}
                          decoding={auDessusDeLaLigne ? 'sync' : 'async'}
                          width="320"
                          height="180"
                        />
                      )}
                      {epLabelStr && (
                        <span class="ep-badge">{epLabelStr}</span>
                      )}
                    </div>
                    <div class="ep-meta">
                      <h3 class="ep-ttl">{epTitle}</h3>
                      <span class="ep-cnt">{`${recoCountByEp.get(e.guid) ?? 0} ${plural(recoCountByEp.get(e.guid) ?? 0, 'reco')}`}</span>
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p
          class="noresult"
          id="ep-noresult"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></p>
      </div>
    </section>
  </main>
</Layout>

<script>
  // Toujours utilises par la grille des EPISODES, plus bas.
  import { fuzzyMatch } from '../utils/search';
  import { applyGridFilter } from '../utils/gridFilter';
  import { chargerFragment } from '../utils/chargerFragment';
  import { cablerFiltreRecos } from '../utils/filtreRecos';
  import { cablerBarreFiltres } from '../utils/barreFiltres';

  // --- Filtrage 100 % client : par type (chips) et par texte (fuzzy) -------
  // Câblé DANS UNE FONCTION, et non au chargement : la grille des recos
  // n'existe plus dans le HTML initial (cf. la section « view-all »), elle
  // arrive au premier clic sur l'onglet. Chercher ses éléments trop tôt ne
  // trouverait rien, et le filtre serait mort.
  //
  // La fonction VIT AILLEURS depuis le 2026-08-18 : `AllRecosView` rend la
  // même interface sans monter ce composant, et Astro n'embarque que les
  // scripts des composants rendus. Sur `/[source]/recos`, le champ et les
  // puces existaient donc sans écouteur.

  // La barre de filtres est dans le HTML initial — elle enveloppe les deux
  // onglets — contrairement a la grille, qui arrive par fragment. Un appel
  // direct suffit donc, sans attendre le premier clic.
  cablerBarreFiltres();

  // Bascule entre « Toutes les recos » et « Par épisode ».
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const views: Record<string, HTMLElement | null> = {
    all: document.getElementById('view-all'),
    episodes: document.getElementById('view-episodes'),
  };
  /**
   * Charge la vue « toutes les recos » au premier affichage, puis jamais plus.
   *
   * `chargement` retient la promesse en cours : deux clics rapides ne doivent
   * pas déclencher deux requêtes ni injecter le contenu deux fois.
   * En cas d'échec réseau, on laisse le lien de repli en place — il mène à la
   * page complète, donc l'utilisateur n'est jamais bloqué.
   *
   * L'injection elle-même, et les annonces qui l'accompagnent, vivent dans
   * `chargerFragment` : v8 n'instrumente pas les scripts client des `.astro`,
   * et cette logique y échapperait à toute mesure de couverture.
   */
  let chargement: Promise<unknown> | null = null;
  function chargerRecos(section: HTMLElement): Promise<unknown> {
    if (chargement) return chargement;
    chargement = chargerFragment(section, cablerFiltreRecos)
      // Un échec ne doit pas figer la vue : on relâche la promesse retenue
      // pour qu'un second clic puisse retenter.
      .then((issue) => {
        if (issue === 'echec') chargement = null;
      });
    return chargement;
  }

  function activateTab(tab: HTMLButtonElement) {
    const view = tab.dataset.view ?? 'all';
    if (view === 'all' && views.all) void chargerRecos(views.all);
    tabs.forEach((t) => {
      const on = t === tab;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', String(on));
      // Roving tabindex (WAI-ARIA Authoring Practices) : seul l'onglet actif
      // est dans l'ordre Tab. Les flèches naviguent entre les onglets.
      t.setAttribute('tabindex', on ? '0' : '-1');
    });
    for (const [key, el] of Object.entries(views)) {
      if (el) el.hidden = key !== view;
    }
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (e: KeyboardEvent) => {
      const idx = tabs.indexOf(tab);
      let next = -1;
      if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      // C4 : Space/Enter activent l'onglet focusé (redondant via <button>
      // natif, mais explicite pour le mode « automatic activation »).
      else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activateTab(tab);
        return;
      }
      if (next >= 0) {
        e.preventDefault();
        activateTab(tabs[next]);
        tabs[next].focus();
      }
    });
  });

  // --- Recherche dans la vue « Par épisode » -------------------------------
  const epGrid = document.getElementById('ep-grid');
  const epSearch = document.getElementById('ep-search') as HTMLInputElement | null;
  const epVisible = document.getElementById('ep-visible');
  const epNoresult = document.getElementById('ep-noresult');
  epSearch?.addEventListener('input', () => {
    const q = epSearch.value;
    applyGridFilter({
      grid: epGrid,
      counter: epVisible,
      // Le libellé suit le nombre : sans ça, filtrer jusqu'à un seul résultat
      // affichait « 1 épisodes ».
      formatCounter: (n) => `${n} ${n >= 2 ? 'épisodes' : 'épisode'}`,
      status: epNoresult,
      emptyMessage: 'Aucun épisode trouvé.',
      matches: (card) => !q.trim() || fuzzyMatch(q, card.dataset.search ?? ''),
    });
  });

  // Le lazy-load des miniatures utilise désormais l'attribut natif
  // `loading="lazy"` sur les <img> rendues côté SSR (meilleure a11y :
  // l'image vit dans le DOM avec son texte alternatif, et le navigateur
  // gère la priorité de chargement).
</script>

<style>
  .head {
    padding: clamp(2rem, 6vw, 4rem) 0 1.5rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .back:hover {
    color: var(--accent);
  }
  .head h1 {
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    margin: 0.6rem 0 0.3rem;
  }
  .tag {
    color: var(--text);
    margin: 0;
  }
  .stat {
    color: var(--muted);
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
  }
  /* Onglets de vue */
  .tabs {
    margin: 0.4rem auto 0;
  }
  .tablist {
    display: flex;
    gap: 0.5rem;
  }
  .tab {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    background: transparent;
    /* Contraste WCAG AA : on utilise text+opacity au lieu de --muted brut
       pour garantir un ratio ≥4.5:1 sur fond --bg (texte d'onglet inactif
       reste lisible). */
    color: color-mix(in oklab, var(--text) 78%, transparent);
    border: 1px solid color-mix(in oklab, var(--text) 30%, transparent);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    /* L20 : Firefox parfois ne met pas cursor:pointer sur <button>. */
    cursor: pointer;
    transition: all 0.16s ease;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab.is-active {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
  }
  .ep-count {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  /* Repli sans JavaScript de l'onglet « Toutes les recos » : remplacé par le
     contenu réel dès que le fragment est chargé. */
  .repli-recos {
    margin: 2rem auto;
    text-align: center;
  }
  .repli-recos a {
    color: var(--accent);
    font-weight: 600;
  }
  /* Grille « par épisode » */
  .ep-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--gap);
  }
  /* Le navigateur SAUTE la mise en page des cartes hors écran, et ne la fait
     qu'au moment où elles approchent. Sur cette page, la mise en page occupait
     798 ms du fil principal pour 25 829 éléments (audit du 2026-08-16) — c'est
     ce qui plombait le Total Blocking Time, la métrique la plus lourdement
     pondérée par Lighthouse.

     `contain-intrinsic-size` est INDISPENSABLE : sans elle, une carte non
     rendue compte pour une hauteur nulle, la page se replie, la barre de
     défilement saute et le CLS — aujourd'hui à 0 — s'effondrerait. La valeur
     est la hauteur observée d'une carte : vignette 16/9 sur 240 px de large,
     plus deux lignes de méta. `auto` demande au navigateur de MÉMORISER la
     vraie hauteur après un premier rendu, et de s'en servir ensuite. */
  .ep-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 220px;
  }
  .ep-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .ep-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--text) 8%, transparent);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s ease;
  }
  .ep-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ep-card a:hover .ep-thumb {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  /* La vignette survolee passe AU-DESSUS de la barre de filtres.

     Le survol la souleve de 4 px, et quand elle se trouve sous la barre
     collante, ces 4 px la font disparaitre un peu plus : on survole une
     vignette dont le haut est mange. Signale a la relecture du 2026-08-18.

     Le `z-index` porte sur `.ep-card` et non sur `.ep-thumb` : la carte a
     `content-visibility: auto`, qui en fait un CONTEXTE D'EMPILEMENT — un
     z-index pose sur la vignette y resterait enferme et ne depasserait jamais
     la barre. Verifie dans Chrome avec `elementFromPoint`.

     6, soit un de plus que la barre (z-index: 5). Le recouvrement ne dure que
     le survol, et ne porte que sur la largeur d'une vignette : on voit
     entierement ce qu'on s'apprete a cliquer. */
  .ep-card:hover {
    position: relative;
    z-index: 6;
  }
  .ep-badge {
    position: absolute;
    top: 0;
    left: 0;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    color: var(--accent);
