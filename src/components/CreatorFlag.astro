---
// Cf. l'en-tête de `creator-flag.css` : styles en fichier, non scopés,
// parce que ce balisage voyage dans le fragment injecté.
import '../styles/creator-flag.css';

/**
 * CreatorFlag — badge ⚠️ + info-bulle sur la situation d'un créateur signalé
 * (accusation / condamnation). N'affiche RIEN si le créateur n'est pas dans
 * `src/data/creator-flags.json`. Contenu 100 % piloté par ce fichier curé —
 * le composant n'invente rien.
 *
 * Deux rendus :
 *  - `interactive` (défaut) : <details> avec la source cliquable. À utiliser
 *    hors d'un lien (page œuvre, RecoCard…).
 *  - `interactive={false}` : simple <span title> non-interactif, valide à
 *    l'intérieur d'une carte-lien (<a>) où un <details>/<a> serait illégal
 *    (WorkCard, GalleryCard). La source se consulte en ouvrant la page œuvre.
 */
import { creatorFlag } from '../data/creatorFlags';

interface Props {
  name?: string | null;
  interactive?: boolean;
}
const { name, interactive = true } = Astro.props;
const flag = name ? creatorFlag(name) : null;
const severity = flag?.severity ?? 'accusation';
const label =
  severity === 'condamnation'
    ? 'Créateur condamné — voir la situation'
    : 'Créateur mis en cause — voir la situation';
---

{
  flag && interactive && (
    <details class="creator-flag" data-severity={severity}>
      <summary aria-label={label} title={label}>
        <span aria-hidden="true">⚠️</span>
      </summary>
      <div class="creator-flag-panel" role="note">
        <p class="creator-flag-sit">{flag.situation}</p>
        {flag.source && (
          <a
            class="creator-flag-src"
            href={flag.source}
            target="_blank"
            rel="noopener noreferrer"
          >
            Source ↗
          </a>
        )}
      </div>
    </details>
  )
}
{
  flag && !interactive && (
    <span
      class="creator-flag-dot"
      data-severity={severity}
      role="img"
      aria-label={`${label} : ${flag.situation}`}
      title={`${label} : ${flag.situation}`}
    >
      ⚠️
    </span>
  )
}
