---
import { getCollection } from 'astro:content';
import SourceCatalog from '../../components/SourceCatalog.astro';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((source) => ({
    params: { source: source.id },
    props: { source },
  }));
}

const { source } = Astro.props;

// Mode mono-source : quand le déploiement n'a qu'un seul podcast, la racine `/`
// affiche déjà ce catalogue (cf. pages/index.astro). L'index de la source
// (/${source.id}) redirige alors vers `/` pour éviter le contenu dupliqué —
// les sous-pages (/${source.id}/episode/…) restent servies normalement.
const sources = await getCollection('sources');
if (sources.length === 1) {
  return Astro.redirect('/', 301);
}
---

<SourceCatalog source={source} />
