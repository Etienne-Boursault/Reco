---
/**
 * Page canonique d'une œuvre (item) — mentions cross-épisodes + trending.
 *
 * Route : `/<source>/oeuvre/<itemId>` (statique). Cf. roadmap item #11 et
 * ADR 0032. Une route par item ayant ≥1 mention visible (non-discarded)
 * dans la source courante. Source des données : collections `items`,
 * `mentions`, `episodes` (cf. content.config.ts).
 *
 * SEO : JSON-LD typé (Movie/Book/MusicAlbum/… via recoToSchema), image OG
 * fallback `/og/default.png` (le générateur Satori n'est pas étendu ici
 * pour ne pas empiéter sur la zone du Dev #15/#16).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { oeuvreAUneCarte } from '../../../lib/og/cartes';
import MentionsTimeline from '../../../components/MentionsTimeline.astro';
import TrendingBadge from '../../../components/TrendingBadge.astro';
import WorkCard from '../../../components/WorkCard.astro';
import CreatorFlag from '../../../components/CreatorFlag.astro';
import WorkFrise from '../../../components/WorkFrise.astro';
import WorkVoix from '../../../components/WorkVoix.astro';
import WorkLiens from '../../../components/WorkLiens.astro';
import { TYPE_LABELS } from '../../../utils/recoTypes';
import { plural } from '../../../utils/plural';
import { frise, parAnnee, periode, quiEnParle } from '../../../lib/work/recurrence';
import {
  hostDeLUrl,
  iconForHost,
  KIND_SYMBOL,
} from '../../../utils/iconesPlateformes';
import { recoToSchema } from '../../../lib/seo/jsonld';
import {
  buildWorkIndex,
  liensDesRecommandations,
  similarByCreator,
  tousLesLiens,
  workExternalLinks,
  type ItemLike,
  type MentionLike,
  type EpisodeLike,
  type WorkAggregate,
  type WorkExternalLink,
} from '../../../lib/work/aggregator';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const items = await getCollection('items');
  const mentions = await getCollection('mentions');
  const episodes = await getCollection('episodes');
  // Les liens vérifiés vivent sur les recommandations, pas sur les fiches
  // d'œuvre. Mention et recommandation partagent leur identifiant : c'est la
  // seule jointure entre les deux collections.
  const recos = new Map(
    (await getCollection('recos')).map((r) => [r.data.id, r.data]),
  );

  const paths: Array<Record<string, unknown>> = [];

  for (const source of sources) {
    const sId = source.id;
    // entry.id pour la collection `items` = chemin relatif sans extension
    // (ex. `un-bon-moment/00080c17`). On filtre sur le préfixe dossier
    // pour garantir l'isolation par source.
    const sItems: ItemLike[] = items
      .filter((it) => it.id.startsWith(`${sId}/`))
      .map((it) => ({
        id: it.data.id,
        title: it.data.title,
        types: it.data.types,
        creator: it.data.creator ?? null,
        year: it.data.year ?? null,
        externalIds: (it.data.externalIds ?? {}) as Record<string, unknown>,
        customLinks: it.data.customLinks ?? [],
        watchProviders: it.data.watchProviders ?? [],
      }));

    // Dédup par id (au cas où deux sources auraient un même itemId).
    const dedupItems = new Map<string, ItemLike>();
    for (const it of sItems) dedupItems.set(it.id, it);

    const sMentions: MentionLike[] = mentions
      .filter((m) => m.data.sourceRef.sourceId === sId)
      .map((m) => ({
        id: m.data.id,
        itemId: m.data.itemId,
        sourceRef: {
          sourceId: m.data.sourceRef.sourceId,
          episodeGuid: m.data.sourceRef.episodeGuid ?? null,
          timestamp: m.data.sourceRef.timestamp ?? null,
          transcriptSource: m.data.sourceRef.transcriptSource ?? null,
        },
        recommendedBy: m.data.recommendedBy ?? null,
        quote: m.data.quote ?? null,
        kind: m.data.kind,
        guestWork: m.data.guestWork ?? null,
        status: m.data.status,
      }));

    const sEpisodes: EpisodeLike[] = episodes
      .filter((e) => e.data.sourceId.id === sId)
      .map((e) => ({
        guid: e.data.guid,
        title: e.data.title,
        youtubeTitle: e.data.youtubeTitle,
        number: e.data.number,
        season: e.data.season,
        date: e.data.date,
        youtubeUrl: e.data.youtubeUrl,
      }));

    const index = buildWorkIndex({
      sourceId: sId,
      items: Array.from(dedupItems.values()),
      mentions: sMentions,
      episodes: sEpisodes,
    });

    // Les candidats aux « œuvres du même créateur » se limitent à celles qui
    // ONT une page. `buildWorkIndex` n'en crée une que pour les œuvres
    // mentionnées ; proposer les autres produisait 337 liens vers des pages
    // introuvables, sur 230 fiches — signalé à la relecture du 2026-08-19
    // depuis la fiche de Kaamelott, qui pointait « Kaamelott, Livre 6 ».
    const itemsAvecPage = Array.from(index.values()).map((w) => w.item);
    // Les mentions PUBLIQUES de chaque œuvre, pour aller y chercher les liens.
    const mentionsParItem = new Map<string, string[]>();
    for (const m of sMentions) {
      if (m.status === 'discarded') continue;
      const liste = mentionsParItem.get(m.itemId) ?? [];
      liste.push(m.id);
      mentionsParItem.set(m.itemId, liste);
    }

    for (const [itemId, work] of index) {
      const similar = similarByCreator(work.item, itemsAvecPage, 3);
      const liensRecos = liensDesRecommandations(
        (mentionsParItem.get(itemId) ?? []).map(
          (mentionId) => recos.get(mentionId)?.links ?? [],
        ),
      );
      paths.push({
        params: { source: sId, itemId },
        props: {
          source,
          work,
          similar,
          liensRecos,
        },
      });
    }
  }

  return paths;
}

// `getStaticPaths` accumule ses routes en `Record<string, unknown>` (les
// props sont heterogenes le temps de la boucle) : Astro ne peut donc rien
// inferer pour `Astro.props`. On declare le contrat ici — c'est la meme forme
// que celle poussee dans `paths`.
type Props = {
  source: CollectionEntry<'sources'>;
  work: WorkAggregate;
  similar: ItemLike[];
  liensRecos: WorkExternalLink[];
};

const { source, work, similar, liensRecos } = Astro.props;
const data = source.data;
const { item, mentions, mentionCount, recoCount, trending, recentCount } = work;

// LA RÉCURRENCE (direction retenue le 2026-10-07 pour la fiche œuvre)
// ------------------------------------------------------------------
// On arrive sur cette page depuis une carte de reco, pour voir que l'œuvre
// REVIENT. L'en-tête le dit en trois chiffres : le total des mentions, celles
// qui sont des recommandations, et depuis quand on en parle. Ils remplacent la
// ligne « Recommandée 5 fois · évoquée 9 fois » : mêmes nombres, mais lisibles
// d'un regard. Calculs : `lib/work/recurrence.ts`.
const laPeriode = periode(mentions);
const laFrise = frise(mentions, source.id);
const qui = quiEnParle(mentions);
const groupes = parAnnee(mentions);
const chiffres = [
  {
    valeur: String(mentionCount),
    legende: `${plural(mentionCount, 'mention')} dans le podcast`,
    accent: true,
  },
  ...(recoCount > 0
    ? [{ valeur: String(recoCount), legende: plural(recoCount, 'recommandation'), accent: true }]
    : []),
  ...(laPeriode
    ? [{ valeur: laPeriode.chiffre, legende: laPeriode.legende, accent: true }]
    : []),
];

const types = item.types ?? [];
const typeLabels = types.map((tp: string) => TYPE_LABELS[tp] ?? tp);

// Les liens de la fiche d'œuvre ET ceux de ses recommandations. Les premiers
// passent devant : ils ont été posés à la main sur l'œuvre.
const links = tousLesLiens(workExternalLinks(item), liensRecos).map((l) => ({
  ...l,
  // Le logo de la plateforme quand il existe localement, sinon un
  // pictogramme selon la nature du lien. Jamais de favicon distante : elle
  // fuiterait l'adresse IP du visiteur vers la plateforme (ADR 0034).
  icone: iconForHost(hostDeLUrl(l.url)),
  symbole: KIND_SYMBOL[l.kind ?? ''] ?? '🔗',
}));

// Comptes sociaux de l'artiste/créateur (handles vérifiés, cf. Phase B liens
// sociaux). item.externalIds est typé Record<string, unknown> → garde de type.
const igHandle =
  typeof item.externalIds?.instagram === 'string' ? item.externalIds.instagram : null;
const tkHandle =
  typeof item.externalIds?.tiktok === 'string' ? item.externalIds.tiktok : null;

// JSON-LD : schema.org typé selon le premier type de l'item. Le mapping
// recoType→schema.org couvre déjà film/livre/album/etc. Le fallback est
// CreativeWork pour les types inconnus (ex. `article`).
const pageUrl = new URL(
  `/${source.id}/oeuvre/${item.id}`,
  Astro.site,
).toString();
const jsonLd = [
  recoToSchema({
    type: types[0] ?? 'autre',
    title: item.title,
    author: item.creator ?? undefined,
    description: item.creator
      ? `${item.title} — ${item.creator}`
      : item.title,
    url: pageUrl,
  }),
];

const descriptionBits: string[] = [];
descriptionBits.push(
  `${item.title}${item.creator ? ` (${item.creator})` : ''}`,
);
descriptionBits.push(
  recoCount > 0
    ? recoCount > 1
      ? t('work.description.reco.many', { count: recoCount, source: data.title })
      : t('work.description.reco.one', { source: data.title })
    : mentionCount > 1
      ? t('work.description.mention.many', { count: mentionCount, source: data.title })
      : t('work.description.mention.one', { source: data.title }),
);
const description = descriptionBits.join(' — ').slice(0, 160);
const pageTitle = item.creator
  ? `${item.title} — ${item.creator}`
  : item.title;
/*
 * IMAGE DE PARTAGE : la carte « Étiquette » de l'œuvre (`oeuvreAUneCarte`,
 * partagée avec l'endpoint OG ; la carte de la SOURCE en repli). Avant
 * l'audit d'interface du 2026-10-07, toutes les pages d'œuvre réclamaient
 * `/og/<source>/oeuvre/<id>.png`, une image que personne ne générait : un 404
 * sur les pages les plus partagées. Le coût d'une carte par œuvre au build
 * est accepté, et amorti par le cache persistant de `renderer.ts`.
 *
 * Ce commentaire est ICI et non dans la liste d'attributs de `<Layout>` : un
 * `{/* … *​/}` y est toléré par Astro mais casse `astro check`, qui lit le
 * fichier comme du TSX. Le piège s'était déjà refermé sur `<StatChart>`.
 */
---

<Layout
  title={pageTitle}
  description={description}
  ogSlug={oeuvreAUneCarte(mentionCount) ? `${source.id}/oeuvre/${item.id}` : source.id}
  ogType="article"
  theme={data.theme}
  jsonLd={jsonLd}
>
  <header class="head wrap" role="banner">
    <a class="back" href={`/${source.id}`}>
      <span aria-hidden="true">←</span> <span>{data.title}</span>
    </a>

    <div class="work-hero">
      <div class="work-ident">
        <p class="work-kicker">
          <span class="work-types">{typeLabels.join(' · ')}</span>
          {item.creator && (
            <>
              <span aria-hidden="true"> · </span>
              <span class="creator">{item.creator}</span>
              <CreatorFlag name={item.creator} />
            </>
          )}
          {item.year && (
            <span class="year" aria-label={t('work.year.a11y', { year: item.year })}> · {item.year}</span>
          )}
        </p>
        <h1>{item.title}</h1>
      </div>

      <div class="work-chiffres-bloc">
        <dl class="work-chiffres">
          {chiffres.map((c) => (
            <div class="work-chiffre">
              <dt>{c.legende}</dt>
              <dd class:list={[{ accent: c.accent }]}>{c.valeur}</dd>
            </div>
          ))}
        </dl>
        {trending && <TrendingBadge count={recentCount} />}
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1" class="wrap">
    {laFrise && laPeriode && (
      <WorkFrise frise={laFrise} titre="Au fil des épisodes" legende={laPeriode.legende} />
    )}

    {(qui.voix.length > 0 || links.length > 0 || igHandle || tkHandle) && (
      <div class="work-duo">
        {qui.voix.length > 0 && <WorkVoix qui={qui} />}
        {(links.length > 0 || igHandle || tkHandle) && (
          <WorkLiens links={links} titreOeuvre={item.title} igHandle={igHandle} tkHandle={tkHandle} />
        )}
      </div>
    )}

    <section aria-labelledby="mentions-heading">
      <h2 id="mentions-heading" class="sec-title">
        {mentionCount > 1
          ? t('work.heading.mention.many', { count: mentionCount })
          : t('work.heading.mention.one')}
      </h2>
      {groupes.map((g) => (
        <section class="annee" aria-labelledby={`annee-${g.annee ?? 'sans-date'}`}>
          <h3 class="annee-titre" id={`annee-${g.annee ?? 'sans-date'}`}>{g.annee ?? 'Date inconnue'}</h3>
          <MentionsTimeline sourceId={source.id} mentions={g.mentions} podcastTitle={data.title} creator={item.creator} />
        </section>
      ))}
    </section>

    {similar.length > 0 && (
      <section aria-labelledby="similar-heading" class="similar">
        <h2 id="similar-heading" class="sec-title">{t('work.heading.similar')}</h2>
        <ul class="similar-grid">
          {similar.map((s) => (
            <li>
              <WorkCard sourceId={source.id} item={s} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .head { padding: clamp(1.5rem, 4vw, 2.5rem) 0 1.5rem; }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover { color: var(--accent); }
  }
  .back:active { color: var(--accent); }
  /* L'identité de l'œuvre à gauche, ses trois chiffres à droite ; ils passent
     dessous dès que la place manque. */
  .work-hero {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }
  .work-ident {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    flex: 1 1 22rem;
  }
  .work-kicker {
    margin: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .work-kicker .year { color: var(--muted); }
  .work-hero h1 {
    margin: 0;
    font-size: clamp(3.25rem, 11vw, 8.75rem);
    line-height: 0.88;
    /* Place des accents des capitales (« ÉLITE »), qui sortent de la boîte du
       titre avec cet interligne et mordaient sur la ligne des types. */
    padding-top: 0.16em;
    overflow-wrap: break-word;
  }
  .work-chiffres-bloc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    flex: 0 1 34rem;
    min-width: min(100%, 18rem);
  }
  .work-chiffres {
    margin: 0;
    width: 100%;
    display: grid;
    /* 5,5 rem : les trois chiffres tiennent de front sur un téléphone de
       390 px, comme dans la maquette. */
    grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
    gap: 1rem;
  }
  /* Le chiffre AU-DESSUS de sa légende à l'écran, mais dans l'ordre dt → dd
     pour les lecteurs d'écran : la légende annonce le chiffre. */
  .work-chiffre {
    display: flex;
    flex-direction: column-reverse;
    /* En colonne inversée, `flex-end` cale en HAUT : les trois chiffres
       restent alignés, même quand une légende passe sur deux lignes. */
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .work-chiffre dt {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .work-chiffre dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.88;
    font-variant-numeric: tabular-nums;
  }
  /* Tous les grands chiffres du site sont jaunes (décision du 2026-10-07,
     second audit) : onglet « Par type », galeries, fiche œuvre, stats. */
  .work-chiffre dd.accent { color: var(--accent); }
  main {
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .work-duo {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 3rem;
  }
  .work-duo > :global(*) { flex: 1 1 20rem; }
  .sec-title {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    margin: 0 0 0.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in oklab, var(--text) 10%, transparent);
  }
  /* Année par année : l'année à gauche sur grand écran, au-dessus sur
     téléphone. */
  .annee {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    padding: 1rem 0;
  }
  .annee-titre {
    flex: 0 0 6.5rem;
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 2.75rem);
    line-height: 1;
    /* À cette taille, l'interlettrage positif des petits titres (h3 global)
       écarte trop les chiffres : il se resserre aux grands corps. */
    letter-spacing: 0;
    color: var(--accent);
  }
  .annee > :global(.timeline) {
    flex: 1 1 32rem;
    min-width: 0;
  }
  .similar-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.7rem;
  }
</style>
