---
/**
 * Page canonique d'une œuvre (item) — mentions cross-épisodes + trending.
 *
 * Route : `/<source>/oeuvre/<itemId>` (statique). Cf. roadmap item #11 et
 * ADR 0032. Une route par item ayant ≥1 mention visible (non-discarded)
 * dans la source courante. Source des données : collections `items`,
 * `mentions`, `episodes` (cf. content.config.ts).
 *
 * SEO : JSON-LD typé (Movie/Book/MusicAlbum/… via recoToSchema), image OG
 * fallback `/og/default.png` (le générateur Satori n'est pas étendu ici
 * pour ne pas empiéter sur la zone du Dev #15/#16).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import MentionsTimeline from '../../../components/MentionsTimeline.astro';
import TrendingBadge from '../../../components/TrendingBadge.astro';
import WorkCard from '../../../components/WorkCard.astro';
import CreatorFlag from '../../../components/CreatorFlag.astro';
import { TYPE_EMOJIS, TYPE_LABELS } from '../../../utils/recoTypes';
import {
  hostDeLUrl,
  iconForHost,
  KIND_SYMBOL,
} from '../../../utils/iconesPlateformes';
import { recoToSchema } from '../../../lib/seo/jsonld';
import {
  buildWorkIndex,
  liensDesRecommandations,
  similarByCreator,
  tousLesLiens,
  workExternalLinks,
  type ItemLike,
  type MentionLike,
  type EpisodeLike,
  type WorkAggregate,
  type WorkExternalLink,
} from '../../../lib/work/aggregator';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const items = await getCollection('items');
  const mentions = await getCollection('mentions');
  const episodes = await getCollection('episodes');
  // Les liens vérifiés vivent sur les recommandations, pas sur les fiches
  // d'œuvre. Mention et recommandation partagent leur identifiant : c'est la
  // seule jointure entre les deux collections.
  const recos = new Map(
    (await getCollection('recos')).map((r) => [r.data.id, r.data]),
  );

  const paths: Array<Record<string, unknown>> = [];

  for (const source of sources) {
    const sId = source.id;
    // entry.id pour la collection `items` = chemin relatif sans extension
    // (ex. `un-bon-moment/00080c17`). On filtre sur le préfixe dossier
    // pour garantir l'isolation par source.
    const sItems: ItemLike[] = items
      .filter((it) => it.id.startsWith(`${sId}/`))
      .map((it) => ({
        id: it.data.id,
        title: it.data.title,
        types: it.data.types,
        creator: it.data.creator ?? null,
        year: it.data.year ?? null,
        externalIds: (it.data.externalIds ?? {}) as Record<string, unknown>,
        customLinks: it.data.customLinks ?? [],
        watchProviders: it.data.watchProviders ?? [],
      }));

    // Dédup par id (au cas où deux sources auraient un même itemId).
    const dedupItems = new Map<string, ItemLike>();
    for (const it of sItems) dedupItems.set(it.id, it);

    const sMentions: MentionLike[] = mentions
      .filter((m) => m.data.sourceRef.sourceId === sId)
      .map((m) => ({
        id: m.data.id,
        itemId: m.data.itemId,
        sourceRef: {
          sourceId: m.data.sourceRef.sourceId,
          episodeGuid: m.data.sourceRef.episodeGuid ?? null,
          timestamp: m.data.sourceRef.timestamp ?? null,
          transcriptSource: m.data.sourceRef.transcriptSource ?? null,
        },
        recommendedBy: m.data.recommendedBy ?? null,
        quote: m.data.quote ?? null,
        kind: m.data.kind,
        guestWork: m.data.guestWork ?? null,
        status: m.data.status,
      }));

    const sEpisodes: EpisodeLike[] = episodes
      .filter((e) => e.data.sourceId.id === sId)
      .map((e) => ({
        guid: e.data.guid,
        title: e.data.title,
        youtubeTitle: e.data.youtubeTitle,
        number: e.data.number,
        season: e.data.season,
        date: e.data.date,
        youtubeUrl: e.data.youtubeUrl,
      }));

    const index = buildWorkIndex({
      sourceId: sId,
      items: Array.from(dedupItems.values()),
      mentions: sMentions,
      episodes: sEpisodes,
    });

    // Les candidats aux « œuvres du même créateur » se limitent à celles qui
    // ONT une page. `buildWorkIndex` n'en crée une que pour les œuvres
    // mentionnées ; proposer les autres produisait 337 liens vers des pages
    // introuvables, sur 230 fiches — signalé à la relecture du 2026-08-19
    // depuis la fiche de Kaamelott, qui pointait « Kaamelott, Livre 6 ».
    const itemsAvecPage = Array.from(index.values()).map((w) => w.item);
    // Les mentions PUBLIQUES de chaque œuvre, pour aller y chercher les liens.
    const mentionsParItem = new Map<string, string[]>();
    for (const m of sMentions) {
      if (m.status === 'discarded') continue;
      const liste = mentionsParItem.get(m.itemId) ?? [];
      liste.push(m.id);
      mentionsParItem.set(m.itemId, liste);
    }

    for (const [itemId, work] of index) {
      const similar = similarByCreator(work.item, itemsAvecPage, 3);
      const liensRecos = liensDesRecommandations(
        (mentionsParItem.get(itemId) ?? []).map(
          (mentionId) => recos.get(mentionId)?.links ?? [],
        ),
      );
      paths.push({
        params: { source: sId, itemId },
        props: {
          source,
          work,
          similar,
          liensRecos,
        },
      });
    }
  }

  return paths;
}

// `getStaticPaths` accumule ses routes en `Record<string, unknown>` (les
// props sont heterogenes le temps de la boucle) : Astro ne peut donc rien
// inferer pour `Astro.props`. On declare le contrat ici — c'est la meme forme
// que celle poussee dans `paths`.
type Props = {
  source: CollectionEntry<'sources'>;
  work: WorkAggregate;
  similar: ItemLike[];
  liensRecos: WorkExternalLink[];
};

const { source, work, similar, liensRecos } = Astro.props;
const data = source.data;
const { item, mentions, mentionCount, recoCount, trending } = work;

// L4 — Le libellé « Recommandée N fois » ne compte QUE les recommandations
// (recoCount = mentions hors citation, œuvres d'invité·es incluses). Une œuvre
// seulement évoquée (recoCount === 0) bascule sur « Mentionnée » (total des
// mentions). La timeline ci-dessous affiche, elle, TOUTES les mentions.
const statLabel =
  recoCount > 0
    ? recoCount > 1
      ? t('work.stats.reco.many', { count: recoCount })
      : t('work.stats.reco.one')
    : mentionCount > 1
      ? t('work.stats.mention.many', { count: mentionCount })
      : t('work.stats.mention.one');

const types = item.types ?? [];
const typeEmojis = types.map((tp: string) => ({
  emoji: TYPE_EMOJIS[tp] ?? '✨',
  label: TYPE_LABELS[tp] ?? tp,
}));
const typeTitle = typeEmojis.map((te: { label: string }) => te.label).join(', ');

// Les liens de la fiche d'œuvre ET ceux de ses recommandations. Les premiers
// passent devant : ils ont été posés à la main sur l'œuvre.
const links = tousLesLiens(workExternalLinks(item), liensRecos).map((l) => ({
  ...l,
  // Le logo de la plateforme quand il existe localement, sinon un
  // pictogramme selon la nature du lien. Jamais de favicon distante : elle
  // fuiterait l'adresse IP du visiteur vers la plateforme (ADR 0034).
  icone: iconForHost(hostDeLUrl(l.url)),
  symbole: KIND_SYMBOL[l.kind ?? ''] ?? '🔗',
}));

// Comptes sociaux de l'artiste/créateur (handles vérifiés, cf. Phase B liens
// sociaux). item.externalIds est typé Record<string, unknown> → garde de type.
const igHandle =
  typeof item.externalIds?.instagram === 'string' ? item.externalIds.instagram : null;
const tkHandle =
  typeof item.externalIds?.tiktok === 'string' ? item.externalIds.tiktok : null;

// JSON-LD : schema.org typé selon le premier type de l'item. Le mapping
// recoType→schema.org couvre déjà film/livre/album/etc. Le fallback est
// CreativeWork pour les types inconnus (ex. `article`).
const pageUrl = new URL(
  `/${source.id}/oeuvre/${item.id}`,
  Astro.site,
).toString();
const jsonLd = [
  recoToSchema({
    type: types[0] ?? 'autre',
    title: item.title,
    author: item.creator ?? undefined,
    description: item.creator
      ? `${item.title} — ${item.creator}`
      : item.title,
    url: pageUrl,
  }),
];

const descriptionBits: string[] = [];
descriptionBits.push(
  `${item.title}${item.creator ? ` (${item.creator})` : ''}`,
);
descriptionBits.push(
  recoCount > 0
    ? recoCount > 1
      ? t('work.description.reco.many', { count: recoCount, source: data.title })
      : t('work.description.reco.one', { source: data.title })
    : mentionCount > 1
      ? t('work.description.mention.many', { count: mentionCount, source: data.title })
      : t('work.description.mention.one', { source: data.title }),
);
const description = descriptionBits.join(' — ').slice(0, 160);
const pageTitle = item.creator
  ? `${item.title} — ${item.creator}`
  : item.title;
/*
 * IMAGE DE PARTAGE : la carte de la SOURCE, pas une carte par œuvre.
 *
 * `ogSlug` valait `${source.id}/oeuvre/${item.id}`, qui demande
 * `/og/<source>/oeuvre/<id>.png` — une route que
 * `src/pages/og/[...slug].png.ts` ne génère pas. Les 1 036 pages d'œuvre
 * déclaraient donc une image répondant 404, et ce sont justement les plus
 * partagées : « regarde cette reco ». Rien ne le signalait, la balise étant
 * syntaxiquement correcte.
 *
 * Une carte par œuvre coûterait ~46 Ko × 1 036, soit une cinquantaine de
 * mégaoctets au build pour des pages dont la plupart ne seront jamais
 * partagées — le dépôt écarte déjà cette dépense pour les épisodes. Les items
 * ne portent par ailleurs aucune affiche à réutiliser : `id`, `title`,
 * `types`, rien d'autre. Mieux vaut une carte juste et générique qu'une image
 * absente.
 *
 * Ce commentaire est ICI et non dans la liste d'attributs de `<Layout>` : un
 * `{/* … *​/}` y est toléré par Astro mais casse `astro check`, qui lit le
 * fichier comme du TSX. Le piège s'était déjà refermé sur `<StatChart>`.
 */
---

<Layout
  title={pageTitle}
  description={description}
  ogSlug={source.id}
  ogType="article"
  theme={data.theme}
  jsonLd={jsonLd}
>
  <header class="head wrap" role="banner">
    <a class="back" href={`/${source.id}`}>
      <span aria-hidden="true">←</span> <span>{data.title}</span>
    </a>

    <div class="work-hero">
      <div class="work-types" aria-label={typeTitle}>
        {typeEmojis.map((tp: { emoji: string; label: string }) => (
          <span class="work-emoji" role="img" title={tp.label}>
            <span aria-hidden="true">{tp.emoji}</span>
            <span class="visually-hidden">{tp.label}</span>
          </span>
        ))}
      </div>
      <h1>{item.title}</h1>
      <div class="work-sub">
        {item.creator && <span class="creator">{item.creator}</span>}
        <CreatorFlag name={item.creator} />
        {item.year && (
          <span class="year" aria-label={t('work.year.a11y', { year: item.year })}>· {item.year}</span>
        )}
      </div>

      {(igHandle || tkHandle) && (
        <div class="work-social">
          {igHandle && (
            <a
              class="social-link"
              href={`https://www.instagram.com/${igHandle}/`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          )}
          {tkHandle && (
            <a
              class="social-link"
              href={`https://www.tiktok.com/@${tkHandle}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              TikTok
            </a>
          )}
        </div>
      )}

      <div class="work-stats">
        <span class="count">{statLabel}</span>
        {trending && <TrendingBadge count={mentionCount} />}
      </div>

      {links.length > 0 && (
        <ul class="work-links" aria-label={t('work.links.a11y')}>
          {links.map((l) => (
            <li>
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                title={l.recherche
                  ? t('work.links.search', { provider: l.label, title: item.title })
                  : undefined}
                aria-label={l.recherche
                  ? t('work.links.search', { provider: l.label, title: item.title })
                  : undefined}
                class:list={[
                  'work-link',
                  { indie: l.ethics === 'indie' },
                  { avoid: l.ethics === 'avoid' },
                  { recherche: l.recherche },
                ]}
              >
                {l.icone ? (
                  <img class="work-link-icone" src={l.icone} alt="" width="22"
                       height="22" loading="lazy" decoding="async" />
                ) : (
                  <span class="work-link-symbole" aria-hidden="true">{l.symbole}</span>
                )}
                <span>{l.label}</span>
                {l.recherche && (
                  <span class="work-link-loupe" aria-hidden="true">🔎</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </header>

  <main id="main" tabindex="-1" class="wrap">
    <section aria-labelledby="mentions-heading">
      <h2 id="mentions-heading" class="sec-title">
        {mentionCount > 1
          ? t('work.heading.mention.many', { count: mentionCount })
          : t('work.heading.mention.one')}
      </h2>
      <MentionsTimeline sourceId={source.id} mentions={mentions} />
    </section>

    {similar.length > 0 && (
      <section aria-labelledby="similar-heading" class="similar">
        <h2 id="similar-heading" class="sec-title">{t('work.heading.similar')}</h2>
        <ul class="similar-grid">
          {similar.map((s) => (
            <li>
              <WorkCard sourceId={source.id} item={s} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .head {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 1.5rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .back:hover {
    color: var(--accent);
  }
  .work-hero {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .work-types {
    display: flex;
    gap: 0.35rem;
    font-size: 1.6rem;
    line-height: 1;
  }
  .work-emoji {
    display: inline-flex;
  }
  .work-hero h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    margin: 0;
  }
  .work-sub {
    color: var(--muted);
    font-size: 1rem;
  }
  .work-sub .creator {
    font-weight: 600;
    color: var(--text);
  }
  .work-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.25em 0.7em;
    border: 1px solid color-mix(in oklab, var(--text) 15%, transparent);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .social-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .work-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .work-stats .count {
    font-weight: 600;
  }
  .work-links {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* Un lien qui mène à une RECHERCHE chez le diffuseur, non à l'œuvre : la
   loupe et le pointillé le disent avant le clic. Cf. `estRecherche`. */
.work-link.recherche {
  border-style: dashed;
}
.work-link-loupe {
  margin-inline-start: 0.35em;
  font-size: 0.85em;
  opacity: 0.7;
}
.work-link {
    display: inline-flex;
    align-items: center;
    /* L'espacement entre l'icône et le texte a été demandé deux fois. Le
       premier essai avait atterri sur `.social-link` : les deux blocs
       commencent par les mêmes trois lignes, et le remplacement a mordu sur
       le mauvais. `em` plutôt que `px` pour qu'il suive la taille du
       libellé. */
    gap: 0.75em;
    padding: 0.4em 1.05em 0.4em 0.75em;
    border-radius: 999px;
    background: color-mix(in oklab, var(--text) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--text) 14%, transparent);
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .work-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .work-link-icone {
    /* Agrandies a la demande : a 16 px, les logos de plateforme se lisaient
       mal a cote d'un texte de 0,85 rem. */
    width: 22px;
    height: 22px;
    border-radius: 3px;
    flex-shrink: 0;
    /* Le logo garde ses couleurs de marque, y compris au survol. */
    object-fit: contain;
  }
  .work-link-symbole {
    font-size: 1.15em;
    line-height: 1;
    flex-shrink: 0;
  }
  .work-link.indie {
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
  }
  .work-link.avoid {
    opacity: 0.55;
  }
  main {
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .sec-title {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    margin: 0 0 1rem;
  }
  .similar-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.7rem;
  }
</style>
