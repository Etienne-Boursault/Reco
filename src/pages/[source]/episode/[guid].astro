---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import RecoCard from '../../../components/RecoCard.astro';
import EpisodeGuests from '../../../components/EpisodeGuests.astro';
import { episodeLabel } from '../../../utils/recoTypes';
import { titreEpisodeAffiche } from '../../../utils/titreEpisode';
import { recoPubliee } from '../../../utils/recoPubliee';
import { sortRecosByTimestamp } from '../../../utils/recoOrder';
import { plural } from '../../../utils/plural';
import { t } from '../../../i18n';
import { episodeToSchema, recoToSchema } from '../../../lib/seo/jsonld';
import { splitEpisodeRecos } from '../../../lib/episode/splitRecos';
import { lienOeuvre, oeuvreParReco } from '../../../utils/oeuvreDesRecos';
import { decouperEnMoments } from '../../../lib/episode/chapitres';
import EpisodeChapitres from '../../../components/EpisodeChapitres.astro';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const recos = await getCollection('recos');
  const episodes = await getCollection('episodes');

  const paths = [];
  for (const source of sources) {
    const sRecos = recos.filter(
      (r) => r.data.sourceId.id === source.id && recoPubliee(r.data.status),
    );
    // Retour utilisateur 2026-07-21 : on génère TOUS les épisodes de la source,
    // même ceux sans reco validée (ex. #21 McFly & Carlito) — le catalogue y
    // renvoie. La page gère le cas « aucune reco » (message dédié).
    const sEpisodes = episodes
      .filter((e) => e.data.sourceId.id === source.id)
      .sort((a, b) => {
        const sa = a.data.season ?? 0;
        const sb = b.data.season ?? 0;
        if (sa !== sb) return sa - sb;
        return (a.data.number ?? 9999) - (b.data.number ?? 9999);
      });
    for (let i = 0; i < sEpisodes.length; i++) {
      const episode = sEpisodes[i];
      const prev = sEpisodes[i - 1];
      const next = sEpisodes[i + 1];
      paths.push({
        params: { source: source.id, guid: episode.data.guid },
        props: {
          source,
          episode: episode.data,
          prevGuid: prev?.data.guid ?? null,
          nextGuid: next?.data.guid ?? null,
          // Tri CHRONOLOGIQUE explicite — l'ordre dans lequel les recos ont
          // été prononcées dans l'épisode. Sans lui, on héritait de l'ordre
          // d'énumération du chargeur de fichiers d'Astro, que la migration
          // 5 → 7 a effectivement changé. Cf. `src/utils/recoOrder.ts`.
          recos: sortRecosByTimestamp(
            sRecos
              .filter((r) => r.data.episodeGuid === episode.data.guid)
              .map((r) => r.data),
          ),
        },
      });
    }
  }
  return paths;
}

const { source, episode, recos, prevGuid, nextGuid } = Astro.props;
const data = source.data;

// Le titre de chaque carte mène à la fiche de son œuvre (cf. `oeuvreDesRecos`).
const oeuvres = oeuvreParReco(
  (await getCollection('mentions'))
    .filter((m) => m.data.sourceRef.sourceId === source.id)
    .map((m) => m.data),
);
const ficheOeuvre = (recoId: string) => lienOeuvre(oeuvres, source.id, recoId);
// En moments de l'écoute (« Les chapitres ») ; `null` → sections par nature.
const moments = decouperEnMoments(recos, episode.youtubeDuration);

const ytId = episode.youtubeUrl?.match(/[?&]v=([\w-]+)/)?.[1];
// Miniature : vignette YouTube si dispo, sinon artwork Acast (imageUrl).
const thumb = ytId ? `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg` : (episode.imageUrl ?? null);
// Dimensions posées UNIQUEMENT pour la vignette YouTube : `hqdefault.jpg` fait
// toujours 480×360. Sans elles, le navigateur réserve zéro place puis décale
// la page quand l'image arrive — c'est du CLS, et c'était la SEULE image du
// site à en produire (audit du 2026-08-16). L'artwork Acast, lui, n'a pas de
// dimension connue à l'avance : on n'invente rien, la règle CSS `aspect-ratio`
// ci-dessous lui réserve la place.
const thumbSize = ytId ? { width: 480, height: 360 } : {};
const epNum = episodeLabel(episode);
// Titre français du flux plutôt que le titre YouTube (parfois en anglais).
const epTitle = episode.title;
// Le grand titre perd le suffixe « (Un Bon Moment, S6-E03) » : le numéro est
// écrit juste au-dessus, et ce suffixe occupait une ligne entière du h1
// (audit d'interface du 2026-10-07). `epTitle`, complet, reste celui du
// <title>, de la description et du JSON-LD — lus sans le badge à côté.
const epTitleAffiche = titreEpisodeAffiche(episode.title, data.title);

// Répartition en 3 seaux pour la PRÉSENTATION de la page épisode (helper pur
// testable). Décision produit (CR Story 4) : les œuvres d'invité·es restent
// comptées comme des recos partout ailleurs sur le site ; seule cette page les
// présente à part. `spontaneous` = recos de l'équipe, `guestWorks` = auto-promos
// d'invité·es, `citations` = œuvres seulement évoquées. Cf. splitEpisodeRecos.
const { spontaneous: spontaneousRecos, guestWorks, citations } =
  splitEpisodeRecos(recos);
// « Recommandations » au sens catalogue = tout ce qui n'est pas une citation
// (spontanées + œuvres d'invités), cohérent avec les compteurs/stats du site.
const recommendationCount = spontaneousRecos.length + guestWorks.length;

// L1/N2 — En-tête : on affiche le MÊME total que la carte annuaire
// (`recoCountByEp` = spontanées + œuvres d'invité·es) et que la meta OG, avec
// un breakdown « dont Y œuvres d'invité·es » seulement si Y > 0. Le cas « que
// des œuvres d'invité·es » (spontanées = 0) reste correct : X = Y et le
// breakdown se lit « X recommandations · dont X œuvres d'invité·es ». Les
// citations, elles, ne sont pas des recos → comptées séparément.
// Seuil `>= 2` et non `> 1` : c'est la règle du projet (`src/utils/plural.ts`),
// donc 0 ET 1 prennent le singulier. Les deux formes sont équivalentes sur des
// entiers — ce qui compte est que la clé singulier reçoive `count`, sinon elle
// affiche le nombre qu'elle code en dur. Un épisode sans reco titrait
// « 1 recommandation » pendant que son corps disait « Aucune recommandation
// extraite de cet épisode » (constaté sur le site construit, 2026-07-29).
const recoCountLabel =
  recommendationCount >= 2
    ? t('episode.count.recommendations.many', { count: recommendationCount })
    : t('episode.count.recommendations.one', { count: recommendationCount });
const guestWorkCountLabel =
  guestWorks.length > 0
    ? guestWorks.length >= 2
      ? t('episode.count.guestWorks.many', { count: guestWorks.length })
      : t('episode.count.guestWorks.one', { count: guestWorks.length })
    : null;
// La section des recos spontanées n'en porte qu'une partie quand l'épisode a
// aussi des œuvres d'invité·es : « Recommandations (4) » sous un en-tête
// « 10 recommandations » se lisait comme une contradiction (audit d'interface
// du 2026-10-07, item #6). Le qualificatif n'apparaît que dans ce cas.
const titreRecosSpontanees =
  guestWorks.length > 0
    ? t('episode.section.recommendations.spontaneous')
    : t('episode.section.recommendations');
const citationCountLabel =
  citations.length > 0
    ? citations.length >= 2
      ? t('episode.count.citations.many', { count: citations.length })
      : t('episode.count.citations.one', { count: citations.length })
    : null;

// JSON-LD : PodcastEpisode + toutes les recommandations (spontanées ET œuvres
// d'invités — elles restent des recos au sens catalogue). Seules les citations
// sont exclues. Cf. ADR 0021 §7.
// Image de partage : la carte « Étiquette » (`ogSlug`) dès que l'épisode a une
// recommandation — elle dit ce qu'il recommande, la vignette YouTube non
// (audit d'interface du 2026-10-07). Sans reco, pas de carte : la vignette.
const episodeUrl = new URL(`/${source.id}/episode/${episode.guid}`, Astro.site).toString();
const sourceUrl = new URL(`/${source.id}`, Astro.site).toString();
const jsonLd: Record<string, unknown>[] = [
  episodeToSchema({
    guid: episode.guid,
    title: epTitle,
    description: episode.description,
    publishedAt: episode.date ? episode.date.toISOString() : undefined,
    url: episodeUrl,
    podcastName: data.title,
    podcastUrl: sourceUrl,
  }),
  ...[...spontaneousRecos, ...guestWorks].map((r) =>
    recoToSchema({
      type: r.types?.[0] ?? 'autre',
      title: r.title,
      author: r.creator,
      description: r.note,
    }),
  ),
];
---

<Layout
  title={`${epTitle} — ${data.title}`}
  description={`${recommendationCount} ${plural(recommendationCount, 'recommandation')} ${plural(recommendationCount, 'extraite')} de ${epTitle}, épisode du podcast ${data.title}.`}
  ogImage={recommendationCount > 0 ? undefined : thumb ?? undefined}
  ogSlug={recommendationCount > 0 ? `${source.id}/episode/${episode.guid}` : source.id}
  ogType="article"
  theme={data.theme}
  jsonLd={jsonLd}
>
  <header class="head wrap" role="banner">
    <a class="back" href={`/${source.id}`}>
      <span aria-hidden="true">←</span> <span>{data.title}</span>
    </a>
    {/* M1 : le hero (thumb + h1 + compteur) est SORTI du <nav> (WCAG 1.3.1 —
       il n'a rien à faire dans un landmark de navigation). Le <nav> ne
       contient plus QUE les flèches ‹ › prev/next. Le layout est reconstitué
       via une grille sur `.ep-nav-row` : `display: contents` sur le <nav>
       promeut les flèches en items de la grille (leur landmark reste exposé),
       et `grid-template-areas` les replace de part et d'autre du hero quel que
       soit l'ordre DOM. */}
    <div class="ep-nav-row">
      <nav class="ep-nav" aria-label={t('nav.episodeNav')}>
        {prevGuid ? (
          <a class="ep-arrow ep-arrow-prev" href={`/${source.id}/episode/${prevGuid}`}
             aria-label={t('nav.prevEpisode')}>
            <span aria-hidden="true">‹</span>
          </a>
        ) : (
          <span class="ep-arrow ep-arrow-prev disabled" aria-hidden="true">‹</span>
        )}
        {nextGuid ? (
          <a class="ep-arrow ep-arrow-next" href={`/${source.id}/episode/${nextGuid}`}
             aria-label={t('nav.nextEpisode')}>
            <span aria-hidden="true">›</span>
          </a>
        ) : (
          <span class="ep-arrow ep-arrow-next disabled" aria-hidden="true">›</span>
        )}
      </nav>
      <div class="ep-hero">
        {
          episode.youtubeUrl ? (
            <a
              class="thumb"
              href={episode.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Regarder « ${epTitle} » sur YouTube ${t('a11y.externalLinkSuffix')}`}
            >
              {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" {...thumbSize} />}
              <span class="play" aria-hidden="true">▶</span>
            </a>
          ) : (
            thumb && <img class="thumb" src={thumb} alt={epTitle} loading="lazy" decoding="async" {...thumbSize} />
          )
        }
        <div class="ep-info">
          {epNum && <span class="epnum">{epNum}</span>}
          <h1>{epTitleAffiche}</h1>
          <p class="count">
            {recoCountLabel}
            {guestWorkCountLabel && (
              <>
                {' '}<span aria-hidden="true">·</span> {guestWorkCountLabel}
              </>
            )}
            {citationCountLabel && (
              <>
                {' '}<span aria-hidden="true">·</span> {citationCountLabel}
              </>
            )}
          </p>
          <EpisodeGuests sourceId={source.id} guests={episode.guests} />
        </div>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1" class="wrap">
    {/* Retour utilisateur 2026-07-21 : on génère désormais TOUS les épisodes,
       même sans reco → message dédié quand les trois seaux sont vides. */}
    {recos.length === 0 && (
      <p class="ep-empty">
        Aucune recommandation extraite de cet épisode pour le moment.
      </p>
    )}
    {moments && <EpisodeChapitres {moments} sourceId={source.id} {episode} {epTitle} {oeuvres} />}
    {!moments && spontaneousRecos.length > 0 && (
      <section class="reco-section">
        <h2 class="sec-title">{titreRecosSpontanees} ({spontaneousRecos.length})</h2>
        <ul class="grid">
          {spontaneousRecos.map((r) => (
            <RecoCard
              reco={r}
              episodeNumber={episode.number}
              episodeSeason={episode.season}
              episodeTitle={epTitle}
              sourceId={source.id}
              oeuvreHref={ficheOeuvre(r.id)}
            />
          ))}
        </ul>
      </section>
    )}
    {!moments && guestWorks.length > 0 && (
      <section class="reco-section guestwork-section">
        <h2 class="sec-title">{t('episode.section.guestWorks')} ({guestWorks.length})</h2>
        <p class="sec-lede">{t('episode.lede.guestWorks')}</p>
        <ul class="grid">
          {guestWorks.map((r) => (
            /* N5 : dans cette sous-section dédiée, on masque le badge « œuvre
               d'invité » sur chaque carte (le titre de section porte déjà
               l'info). Le badge reste actif partout ailleurs. */
            <RecoCard
              reco={r}
              episodeNumber={episode.number}
              episodeSeason={episode.season}
              episodeTitle={epTitle}
              sourceId={source.id}
              oeuvreHref={ficheOeuvre(r.id)}
              showGuestWorkBadge={false}
            />
          ))}
        </ul>
      </section>
    )}
    {!moments && citations.length > 0 && (
      <section class="reco-section citation-section">
        <h2 class="sec-title">{t('episode.section.citations')} ({citations.length})</h2>
        <p class="sec-lede">{t('episode.lede.citations')}</p>
        <ul class="grid">
          {citations.map((r) => (
            <RecoCard
              reco={r}
              episodeNumber={episode.number}
              episodeSeason={episode.season}
              episodeTitle={epTitle}
              sourceId={source.id}
              oeuvreHref={ficheOeuvre(r.id)}
            />
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>

<style>
  .head {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 1.5rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      color: var(--accent);
    }
  }
  .back:active {
    color: var(--accent);
  }
  /* M1 : rangée hero + flèches. La grille place `prev | hero | next` sans que
     le hero soit un descendant du <nav>. */
  .ep-nav-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'prev hero next';
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  /* Le <nav> ne sert qu'à porter le landmark : `display: contents` fait
     participer les flèches directement à la grille `.ep-nav-row`. */
  .ep-nav {
    display: contents;
  }
  .ep-arrow-prev {
    grid-area: prev;
  }
  .ep-arrow-next {
    grid-area: next;
  }
  .ep-hero {
    grid-area: hero;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
  }
  .ep-arrow {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 14%, transparent);
    color: var(--text);
    text-decoration: none;
    font-size: 1.8rem;
    line-height: 1;
    transition:
      border-color 0.16s ease,
      color 0.16s ease,
      background 0.16s ease,
      transform 0.16s ease;
  }
  /* Survol réservé aux vrais pointeurs, appui immédiat pour tous — cf. la
     convention en tête de `global.css` (audit d'interface du 2026-10-07). */
  @media (hover: hover) and (pointer: fine) {
    a.ep-arrow:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: color-mix(in oklab, var(--accent) 12%, transparent);
    }
  }
  /* `a.` : la flèche désactivée est un <span>, rien ne doit réagir à son
     appui. */
  a.ep-arrow:active {
    transform: scale(0.92);
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    transition-duration: 0.08s;
  }
  .ep-arrow.disabled {
    opacity: 0.25;
    cursor: default;
  }
  .thumb {
    position: relative;
    flex: 0 0 auto;
    width: min(100%, 360px);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    display: block;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 2.5rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.25);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    a.thumb:hover .play {
      opacity: 1;
    }
  }
  /* Sans survol, le pictogramme ▶ n'apparaissait JAMAIS : au doigt, rien ne
     disait que la vignette ouvre la vidéo. On le montre donc en permanence,
     sans le voile sombre qui ternirait l'image. */
  @media (hover: none) {
    a.thumb .play {
      opacity: 1;
      background: transparent;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    }
  }
  a.thumb:active .play {
    opacity: 1;
    transition-duration: 0.08s;
  }
  .ep-info {
    flex: 1 1 280px;
  }
  .epnum {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .ep-info h1 {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    margin: 0.3rem 0;
  }
  .count {
    color: var(--muted);
    margin: 0;
  }
  main {
    padding-bottom: 4rem;
  }
  .reco-section + .reco-section {
    margin-top: 3rem;
  }
  .sec-title {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    margin: 0 0 0.4rem;
  }
  .sec-lede {
    color: var(--muted);
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }
  .citation-section .sec-title {
    color: var(--muted);
  }
  .guestwork-section .sec-title {
    /* H1 : teinte dérivée du thème (cf. global.css) pour le contraste AA. */
    color: var(--guestwork);
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0 4rem;
  }
</style>
