---
/**
 * /[source]/reports — queue admin des signalements (build-time, noindex).
 *
 * ⚠ NON CONSTRUITE PAR DÉFAUT — il faut `RECO_ADMIN=1`.
 *
 * Cette page rend le nom, l'ADRESSE E-MAIL et le texte libre des personnes
 * qui signalent une erreur. Elle était pré-rendue sans condition, donc écrite
 * dans `dist/` et **déployée avec le site public** : au premier signalement
 * reçu, l'adresse d'un visiteur devenait lisible par quiconque, sans
 * authentification (revue de sécurité du 2026-07-29).
 *
 * `noindex`, `Disallow: /*​/reports` dans robots.txt et le filtre sitemap ne
 * sont que des mesures de DÉCOUVRABILITÉ, jamais d'ACCÈS — et `robots.txt`
 * publie justement le motif d'URL, tandis que les `sourceId` sont sur la page
 * d'accueil. Le texte de la page dit lui-même « Queue interne — non destinée
 * au public ».
 *
 * D'où le garde : sans `RECO_ADMIN=1`, `getStaticPaths` ne renvoie AUCUNE
 * route et rien n'atterrit dans `dist/`. Pour consulter la queue en local :
 *     RECO_ADMIN=1 npm run build
 * ou, sans build du tout (recommandé) :
 *     python tools/manage_reports.py --list
 *
 * Même arbitrage que pour `/verifier`, retirée du build public en 408c827a.
 * Même mécanisme que `RECO_SSR=1` : un flag d'environnement explicite, absent
 * par défaut, plutôt qu'une page publique qu'on espère non trouvée.
 *
 * Pas de bouton d'action — la résolution se fait via le CLI
 * `tools/manage_reports.py` (lockfile pipeline, traçabilité).
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { listReports } from '../../lib/reports/storage.js';
import { t } from '../../i18n';

/** `true` seulement si l'opérateur a explicitement demandé la queue admin. */
export const ADMIN_BUILD = process.env.RECO_ADMIN === '1';

export async function getStaticPaths() {
  // Aucune route sans le flag : la page n'existe pas dans un build public.
  if (!ADMIN_BUILD) return [];
  const sources = await getCollection('sources');
  return sources.map((source) => ({
    params: { source: source.id },
    props: { source },
  }));
}

const { source } = Astro.props;
const data = source.data;

// Reports en queue (lecture build-time). Filtrage status géré côté template.
const allReports = listReports(source.id);
const pending = allReports.filter((r) => r.status === 'pending');
const resolved = allReports.filter((r) => r.status === 'resolved');
const dismissed = allReports.filter((r) => r.status === 'dismissed');

// Accord au nombre des deux compteurs variables (« en attente » est
// invariable). Règle du projet : pluriel dès `n >= 2`, cf. `src/utils/plural.ts`.
const resolvedLabel = t(
  resolved.length >= 2 ? 'report.admin.stats.resolved.many' : 'report.admin.stats.resolved.one',
);
const dismissedLabel = t(
  dismissed.length >= 2 ? 'report.admin.stats.dismissed.many' : 'report.admin.stats.dismissed.one',
);

const CATEGORY_LABELS: Record<string, string> = {
  error: t('report.admin.cat.error'),
  'broken-link': t('report.admin.cat.brokenLink'),
  inappropriate: t('report.admin.cat.inappropriate'),
  suggestion: t('report.admin.cat.suggestion'),
};

/**
 * Horodatage lisible, ou la valeur BRUTE si elle n'est pas une date.
 *
 * Le `try/catch` d'origine ne pouvait rien attraper : `toLocaleString()` ne
 * lève pas sur une date invalide, il renvoie la chaîne « Invalid Date ». Le
 * repli était donc du code mort, et la page affichait « Invalid Date » — sans
 * valeur pour qui administre la file : on veut voir ce qui est réellement
 * stocké pour comprendre d'où vient la corruption.
 */
function fmt(d: string): string {
  const parsed = new Date(d);
  return Number.isNaN(parsed.getTime()) ? d : parsed.toLocaleString('fr-FR');
}
---

<Layout title={t('report.admin.metaTitle', { source: data.title })} theme={data.theme} noindex>
  <header class="head wrap">
    <a class="back" href={`/${source.id}`}>
      <span aria-hidden="true">←</span> {t('report.admin.back')}
    </a>
    <h1>{t('report.admin.title')}</h1>
    <p class="stats">
      <strong>{pending.length}</strong> {t('report.admin.stats.pending')} · {resolved.length} {resolvedLabel} ·
      {dismissed.length} {dismissedLabel}
    </p>
    <p class="hint">
      {t('report.admin.hintPrefix')} <code>python tools/manage_reports.py --resolve &lt;id&gt;</code>.
    </p>
  </header>

  <main id="main" tabindex="-1" class="wrap">
    {pending.length === 0 ? (
      <p class="empty">{t('report.admin.empty')}</p>
    ) : (
      <ul class="reports">
        {pending.map((r) => (
          <li class="report">
            <header>
              <span class="cat">{CATEGORY_LABELS[r.category] ?? r.category}</span>
              <span class="at">{fmt(r.submittedAt)}</span>
            </header>
            <p class="meta">
              <strong>{t('report.admin.recoLabel')}</strong>{' '}
              <a href={`/${r.sourceId}/report/${r.recoId}`}>
                {r.recoId}
              </a>
            </p>
            <p class="details">{r.details}</p>
            {(r.submitter.name || r.submitter.email) && (
              <p class="submitter">
                {r.submitter.name && <span>{r.submitter.name}</span>}
                {r.submitter.email && <span class="email">&lt;{r.submitter.email}&gt;</span>}
                {r.submitter.wantCredit && <span class="credit">{t('report.admin.wantCredit')}</span>}
              </p>
            )}
            <p class="id"><code>{r.id}</code></p>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>

<style>
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 1.5rem 1.2rem 4rem;
  }
  .back {
    font-size: 0.9rem;
  }
  .stats strong {
    font-size: 1.2em;
  }
  .hint {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }
  ul.reports {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .report {
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 12%, transparent);
    border-radius: var(--radius, 8px);
    padding: 0.9rem 1rem;
  }
  .report header {
    display: flex;
    gap: 0.6rem;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.85rem;
  }
  .cat {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 18%, transparent);
    font-weight: 600;
  }
  .at {
    color: var(--muted);
  }
  .details {
    white-space: pre-wrap;
    margin: 0.4rem 0;
  }
  .submitter {
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .credit {
    color: var(--accent);
    font-weight: 600;
  }
  .id {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
