---
/**
 * /[source]/invite/[name] — la page d'un invité dans une source.
 *
 * Source des noms d'invités : champ `recommendedBy` des mentions publiques,
 * dédupliqué + slugifié pour produire l'URL. Cf. ADR 0031.
 *
 * DIRECTION B « BIBLIOTHÈQUE » (maquettes du 2026-10-07)
 * ------------------------------------------------------
 * Ses passages en pastilles dans l'en-tête, puis SES œuvres d'abord — ce
 * qu'elle a créé et présenté —, puis ce qu'elle recommande, groupé par type,
 * et enfin, en une ligne, ce qu'elle n'a fait qu'évoquer. La page était une
 * grille indifférenciée où l'auto-promotion et les vraies recommandations se
 * mélangeaient. Le calcul vit dans `lib/gallery/invite.ts` (testé), avec la
 * règle « ses œuvres = celles dont la personne est créatrice ».
 *
 * NB : la page ne retient que les mentions dont `recommendedBy` est
 * EXACTEMENT ce nom ; une reco collective (« A & B ») reste sur sa propre
 * page. Les passages, eux, comptent aussi les épisodes où la personne était
 * invitée sans rien recommander.
 */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { listGuests, selectByGuest } from '../../../lib/gallery/aggregate';
import { buildGuestIndex } from '../../../lib/gallery/slug';
import { galleryBreadcrumb, galleryItemListSchema } from '../../../lib/gallery/page';
import { bibliothequeDeLInvite, prenom, type LigneInvite } from '../../../lib/gallery/invite';
import { TYPE_LABELS, TYPE_LABELS_PLURAL, episodeLabel } from '../../../utils/recoTypes';
import { plural } from '../../../utils/plural';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const allMentions = await getCollection('mentions');
  const paths: Array<{
    params: { source: string; name: string };
    props: { source: (typeof sources)[number]; guestName: string };
  }> = [];
  for (const source of sources) {
    const mentions = allMentions
      .filter((m) => m.data.sourceRef.sourceId === source.id)
      .map((m) => m.data);
    const hosts = source.data.hosts ?? [];
    const guestNames = listGuests(mentions, hosts);
    const index = buildGuestIndex(guestNames);
    for (const [slug, guestName] of index) {
      paths.push({
        params: { source: source.id, name: slug },
        props: { source, guestName },
      });
    }
  }
  return paths;
}

const { source, guestName } = Astro.props;
const data = source.data;

const mentions = (await getCollection('mentions'))
  .filter((m) => m.data.sourceRef.sourceId === source.id)
  .map((m) => m.data);
const mentionedIds = new Set(mentions.map((m) => m.itemId));
const items = (await getCollection('items'))
  .map((i) => i.data)
  .filter((it) => mentionedIds.has(it.id));
const episodes = (await getCollection('episodes'))
  .filter((e) => e.data.sourceId.id === source.id)
  .map((e) => e.data);

// La liste plate reste celle du JSON-LD et de la description : elle dit ce
// que la page contient, dans l'ordre des galeries du site.
const entries = selectByGuest(items, mentions, guestName);
const bib = bibliothequeDeLInvite(guestName, items, mentions, episodes);

const heading = `${t('gallery.guest.titlePrefix')} ${guestName}`;
const countLabel = t(
  entries.length >= 2 ? 'gallery.guest.count.many' : 'gallery.guest.count.one',
);
const description = `${entries.length} ${countLabel} de ${guestName} dans ${data.title}.`;

const nbPassages = bib.passages.length;
const nbOeuvres = bib.sesOeuvres.length;
// « 14 recommandations en 4 passages, et 5 de ses œuvres présentées dans le
// podcast. » Le possessif « ses » s'accorde avec « œuvres », pas avec la
// personne : il ne suppose aucun genre.
const resume =
  `${bib.nbRecommandations} ${plural(bib.nbRecommandations, 'recommandation')}` +
  (nbPassages > 0 ? ` en ${nbPassages} ${plural(nbPassages, 'passage')}` : '') +
  (nbOeuvres > 0
    ? `, et ${nbOeuvres} de ses œuvres ${plural(nbOeuvres, 'présentée')} dans le podcast`
    : '') +
  '.';

const href = (id: string) => `/${source.id}/oeuvre/${id}`;
const etiquettes = (l: LigneInvite) =>
  l.episodes.map((e) => episodeLabel(e) || e.title).join(', ');
const moisAnnee = (d?: Date) =>
  d ? d.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';

const sourceUrl = new URL(`/${source.id}`, Astro.site).toString();
const homeUrl = new URL('/', Astro.site).toString();
const slug = Astro.params.name;
const galleryUrl = new URL(`/${source.id}/invite/${slug}`, Astro.site).toString();

const jsonLd = [
  galleryItemListSchema(entries, { name: heading, description }),
  galleryBreadcrumb({
    homeUrl,
    sourceName: data.title,
    sourceUrl,
    galleryName: guestName,
    galleryUrl,
  }),
];
---

<Layout
  title={`${heading} — ${data.title}`}
  description={description}
  theme={data.theme}
  ogSlug={source.id}
  jsonLd={jsonLd}
>
  <header class="head wrap" role="banner">
    <div class="identite">
      <a class="back" href={`/${source.id}`}>
        <span aria-hidden="true">←</span> <span>{t('gallery.backToSource')} {data.title}</span>
      </a>
      <h1>{guestName}</h1>
      <p class="resume">{resume}</p>
    </div>
    {nbPassages > 0 && (
      <nav class="passages" aria-label={`Passages de ${guestName} dans le podcast`}>
        <span class="surtitre">{plural(nbPassages, 'Son passage', 'Ses passages')}</span>
        <ul>
          {bib.passages.map((e) => (
            <li>
              <a href={`/${source.id}/episode/${e.guid}`}>
                <strong>{episodeLabel(e) || '—'}</strong> {moisAnnee(e.date)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </header>

  <main id="main" tabindex="-1" class="wrap">
    {bib.sesOeuvres.length > 0 && (
      <section class="bloc" aria-labelledby="ses-oeuvres">
        <div class="bloc-titre">
          <h2 id="ses-oeuvres">Ses œuvres</h2>
          <span>présentées dans le podcast</span>
        </div>
        <ul class="oeuvres">
          {bib.sesOeuvres.map((l) => (
            <li>
              <a class="oeuvre" href={href(l.oeuvre.id)}>
                <span class="oeuvre-type">{TYPE_LABELS[l.oeuvre.types[0] ?? 'autre'] ?? l.oeuvre.types[0]}</span>
                <span class="oeuvre-titre">{l.oeuvre.title}</span>
                {l.oeuvre.creator && <span class="oeuvre-createur">{l.oeuvre.creator}</span>}
                <span class="oeuvre-ou">
                  Présentée {l.episodes.length} {plural(l.episodes.length, 'fois', 'fois')}
                  {l.episodes.length > 0 && <> · {etiquettes(l)}</>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {bib.recommandations.length > 0 && (
      <section class="bloc" aria-labelledby="ses-recos">
        <div class="bloc-titre">
          <h2 id="ses-recos">Ce que {prenom(guestName)} recommande</h2>
          <span>{bib.nbRecommandations} {plural(bib.nbRecommandations, 'recommandation')}, par type</span>
        </div>
        <div class="groupes">
          {bib.recommandations.map((g) => (
            <section class="groupe" aria-label={TYPE_LABELS_PLURAL[g.type] ?? g.type}>
              <h3><span>{TYPE_LABELS_PLURAL[g.type] ?? g.type}</span><span>{g.lignes.length}</span></h3>
              <ul>
                {g.lignes.map((l) => (
                  <li>
                    <a href={href(l.oeuvre.id)}>
                      <span class="ligne-texte">
                        <span class="ligne-titre">{l.oeuvre.title}</span>
                        {l.oeuvre.creator && <span class="ligne-createur">{l.oeuvre.creator}</span>}
                      </span>
                      <span class="ligne-ep">{etiquettes(l)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
        {bib.evoquees.length > 0 && (
          <p class="evoquees">
            Évoquées au passage, sans être recommandées :
            {bib.evoquees.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={href(l.oeuvre.id)}>{l.oeuvre.title}</a>
                {` (${[l.oeuvre.creator, etiquettes(l)].filter(Boolean).join(', ')})`}
              </>
            ))}
          </p>
        )}
      </section>
    )}

    {bib.sesOeuvres.length === 0 && bib.recommandations.length === 0 && (
      <p class="vide">Pas encore de recommandation de {guestName} dans ce podcast.</p>
    )}
  </main>
</Layout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1rem, 4vw, 2.5rem) 0 2rem;
    border-bottom: 1px solid color-mix(in oklab, var(--text) 12%, transparent);
    margin-bottom: 2.5rem;
  }
  .identite {
    flex: 1 1 28rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .back {
    align-self: flex-start;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .head h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    line-height: 0.88;
    /* L'interligne serré fait sortir les accents des capitales (« CÉDRIC ») de
       la boîte du titre : sans cette marge, ils mordaient sur le lien de retour. */
    padding-top: 0.16em;
    overflow-wrap: break-word;
  }
  .resume {
    margin: 0.6rem 0 0;
    max-width: 46ch;
    color: color-mix(in oklab, var(--text) 85%, transparent);
  }
  .passages {
    flex: 0 1 26rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .surtitre {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .passages ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .passages a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--text) 25%, transparent);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .passages strong {
    color: var(--accent);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    padding-bottom: 4rem;
  }
  .bloc {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .bloc-titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .bloc-titre h2 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }
  .bloc-titre span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .oeuvres {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
  }
  .oeuvres li {
    display: flex;
  }
  .oeuvre {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 180px;
    padding: 1.3rem;
    border-radius: var(--radius);
    /* Distinguées par un FOND à peine teinté, pas par une bordure jaune :
       partout ailleurs sur le site, la bordure jaune signale le survol ou
       l'appui, et ces cartes avaient l'air déjà sélectionnées (second audit
       d'interface du 2026-10-07). La bordure jaune revient au survol. */
    border: 1px solid color-mix(in oklab, var(--text) 10%, transparent);
    background: color-mix(in oklab, var(--accent) 6%, var(--surface));
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }
  .oeuvre:active {
    border-color: var(--accent);
    transition-duration: 0.08s;
  }
  .oeuvre-type {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .oeuvre-titre {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .oeuvre-createur {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .oeuvre-ou {
    margin-top: auto;
    font-size: 0.82rem;
    color: color-mix(in oklab, var(--text) 80%, transparent);
  }

  .groupes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
    align-items: start;
  }
  .groupe {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.2rem 1.3rem;
    background: var(--surface);
    border: 1px solid color-mix(in oklab, var(--text) 10%, transparent);
    border-radius: var(--radius);
  }
  .groupe h3 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .groupe ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .groupe li {
    border-top: 1px solid color-mix(in oklab, var(--text) 10%, transparent);
  }
  .groupe a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    min-height: 56px;
    padding: 0.4rem 0;
    text-decoration: none;
  }
  .ligne-texte {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .ligne-titre {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.05;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  .ligne-createur {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .ligne-ep {
    flex: 0 0 auto;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.78rem;
    text-align: right;
  }
  .evoquees {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .evoquees a {
    color: var(--text);
  }
  .vide {
    color: var(--muted);
  }

  /* Survol réservé aux vrais pointeurs, appui immédiat : conventions de
     l'audit d'interface du 2026-10-07 (cf. `global.css`). */
  @media (hover: hover) and (pointer: fine) {
    .back:hover,
    .groupe a:hover .ligne-titre,
    .evoquees a:hover {
      color: var(--accent);
    }
    .passages a:hover,
    .oeuvre:hover {
      border-color: var(--accent);
      background: color-mix(in oklab, var(--accent) 10%, var(--surface));
    }
  }
  .passages a:active,
  .oeuvre:active {
    transform: scale(0.98);
  }
</style>
