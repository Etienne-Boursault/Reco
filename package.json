{
  "name": "reco",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Catalogue duplicable des recommandations de podcasts (Un Bon Moment, etc.)",
  "bin": {
    "reco": "./bin/reco"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "node --env-file-if-exists=.env ./server.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "init": "node bin/reco init",
    "test:a11y": "node tests/a11y/check_a11y.mjs",
    "test:contrast": "node tests/a11y/check_contrast.mjs",
    "test:a11y:all": "npm run build && npm run test:a11y && npm run test:contrast",
    "test:seo": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:og": "vitest run tests/og"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.5",
    "minisearch": "^7.2.0",
    "satori": "^0.33.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.11.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
