// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`graphes par jour > rend les deux graphes tels qu’avant leur extraction dans GrapheJours 1`] = `"<section class="graphe"> <h2>Visiteurs par jour</h2> <div class="barres"> <div class="barre" title="JOUR-2 — 1 visiteurs, 1 pages vues, 0 passages de robots"> <span class="nombre">1</span> <i style="height:50%"></i> </div><div class="barre" title="JOUR-1 — 2 visiteurs, 2 pages vues, 2 passages de robots"> <span class="nombre">2</span> <i style="height:100%"></i> </div> </div> <div class="axe"> <span>JJ2/MM2</span> <span>JJ1/MM1</span> </div> <p class="legende"> Personnes distinctes ayant ouvert au moins une page dans la journée, hors robots et hors erreurs. Les pages préchargées au survol d’un lien ne comptent pas comme vues. </p> </section> <section class="graphe"> <h2>Passages de robots par jour</h2> <div class="barres robots"> <div class="barre" title="JOUR-2 — 0 passages de robots"> <span class="nombre"></span> <i style="height:2%"></i> </div><div class="barre" title="JOUR-1 — 2 passages de robots"> <span class="nombre">2</span> <i style="height:100%"></i> </div> </div> <div class="axe"> <span>JJ2/MM2</span> <span>JJ1/MM1</span> </div> <p class="legende"> Requêtes qui se déclarent robots (moteurs, aperçus de liens, aspirateurs), et celles qui se disent navigateurs sans annoncer de langue — ce qu’un vrai navigateur fait toujours. </p> </section>"`;
